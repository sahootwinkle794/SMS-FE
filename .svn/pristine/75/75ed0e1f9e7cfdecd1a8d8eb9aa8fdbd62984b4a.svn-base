:root {
  --background: #f2f2f2;
  --body-bg: #ffffff;
  --foreground: #17171748;
  --primary: #2e5799;
  --secondary: #23a5b9;
  --link: #0d588d;
  --danger: #e51619;
  --primary-gradient: linear-gradient(
    145.36deg,
    #177699 17.42%,
    #00307d 87.28%
  );
  --primary-text: #fcfcfc;
  --success: #00ab06;
  --header: #0478b6;
  --dark-subtle: #535353;
  --font-ibm-plex: "IBM Plex Sans", sans-serif;
  --carousel-indicator: #a14586;
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
}

body {
  color: var(--foreground);
  background: var(--background);
  font-family: Arial, Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

@media (prefers-color-scheme: dark) {
  html {
    color-scheme: dark;
  }
}

*::-webkit-scrollbar {
  width: 3px;
  height: 6px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background: var(--mantine-color-gray-5);
  border-radius: 10px;
}

*::-webkit-scrollbar-thumb:hover {
  background: var(--mantine-color-gray-6);
}

.scroll-container {
  scrollbar-width: thin;
  scrollbar-color: var(--mantine-color-gray-5) transparent;
}

.mantine-Drawer-close {
  color: var(--body-bg) !important;
}
.mantine-Drawer-close:hover {
  color: var(--dark-subtle) !important;
}

.mantine-Modal-close {
  color: var(--foreground) !important;
}

.mantine-Modal-close:hover {
  color: var(--dark-subtle) !important;
}

.mantine-Select-wrapper {
  border: 1px solid #00000021 !important;
}

/* ---------------------------------Main Page Loading UI----------------------------------------- */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(50px) scaleY(0.85);
  }
  to {
    opacity: 1;
    transform: translateY(0) scaleY(1);
  }
}
@keyframes blink {
  0%,
  100% {
    opacity: 0.12;
  }
  50% {
    opacity: 0.85;
  }
}
@keyframes floatParticle {
  from {
    transform: translateY(0px) translateX(0px);
  }
  to {
    transform: translateY(-18px) translateX(8px);
  }
}
@keyframes orbFloat {
  from {
    transform: translate(0, 0) scale(1);
  }
  to {
    transform: translate(20px, -20px) scale(1.05);
  }
}
@keyframes floatPin {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-6px);
  }
}
@keyframes ringPulse {
  0% {
    transform: scale(0.92);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.4;
  }
  100% {
    transform: scale(1.12);
    opacity: 0;
  }
}
.building-group {
  animation: rise 3.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.b1 {
  animation-delay: 0s;
}
.b2 {
  animation-delay: 0.5s;
}
.b3 {
  animation-delay: 0.25s;
}
.b4 {
  animation-delay: 0.75s;
}
.b5 {
  animation-delay: 1s;
}
.window {
  animation: blink var(--dur) ease-in-out infinite;
  animation-delay: var(--delay);
}
