"use client";

import { AppBreadcrumbs, CommonCategory } from "@/components";
import { DrawerForm } from "@/components";
import { Field } from "@/components/DrawerForm/DrawerForm";
import {
  Box,
  Container,
  Button,
  useMantineTheme,
  Paper,
  Stack,
  Skeleton,
  Text,
  Center,
} from "@mantine/core";
import { useState, useMemo, useEffect } from "react";
import { IconPlus, IconX } from "@tabler/icons-react";
import { RouteConfig } from "@/utils/routeConfig";
import { COMMON_MESSAGE, STATUS_OPTIONS } from "@/utils/constants";
import { IconLayersOff } from "@tabler/icons-react";
import { API_PATH } from "@/utils/apiPath";
import { getRequest, postRequest } from "@/service";
import {
  Amenity,
  AmenityApiResponse,
  AmenityCategory,
  ApiResponse,
  CatAmenityDetail,
  CatAmenityMapApiResponse,
} from "@/types/admin/societyManagement/facandame/amenitiesMapping/amenitiesMapping";
import { notifications } from "@mantine/notifications";

const AmenityMapping = () => {
  const [drawerOpened, setDrawerOpened] = useState<boolean>(false);
  const [editMode, setEditMode] = useState<boolean>(false);
  const [drawerInitialValues, setDrawerInitialValues] = useState<Record<string, any> | undefined>(undefined);
  const [amenityCategories, setAmenityCategories] = useState<AmenityCategory[]>([]);
  const [amenities, setAmenities] = useState<Amenity[]>([]);
  const [categoryAmenityMap, setCategoryAmenityMap] = useState<Record<string, CatAmenityDetail[]>>({});
  const [loading, setLoading] = useState<boolean>(true);
  const [removedAmenities, setRemovedAmenities] = useState<
    Array<{ amenityId: string; displayOrder: number; status: number }>
  >([]);

  const theme = useMantineTheme();

  // ─── Helpers ────────────────────────────────────────────────────────────────

  const notifyError = (msg: string) =>
    notifications.show({
      title: "Error",
      message: msg,
      color: "red",
      icon: <IconX size={16} />,
    });

  // ─── Derived State ───────────────────────────────────────────────────────────

  const currentCategories = useMemo(() => {
    return amenityCategories
      .filter((cat: AmenityCategory) => cat.status === 1)
      .map((cat: AmenityCategory) => {
        const sorted = (categoryAmenityMap[cat.genCode] ?? [])
          .slice()
          .sort((a: CatAmenityDetail, b: CatAmenityDetail) => (a.displayOrder ?? 0) - (b.displayOrder ?? 0));

        return {
          title: cat.genName || "Untitled Category",
          amenities: sorted.map((a: CatAmenityDetail) => a.amenityName),
          amenityStatuses: Object.fromEntries(
            sorted.map((a: CatAmenityDetail) => [a.amenityName, a.status === 1]),
          ),
          amenityDisplayOrders: Object.fromEntries(
            sorted.map((a: CatAmenityDetail) => [a.amenityName, a.displayOrder]),
          ),
          categoryCode: cat.genCode,
          status: cat.status,
        };
      });
  }, [amenityCategories, categoryAmenityMap]);

  // ─── Form Config ─────────────────────────────────────────────────────────────

  const formFields: Field[] = [
    {
      name: "categoryCode",
      label: "Category",
      type: "select",
      placeholder: "Select category",
      required: true,
      colSpan: 6,
      options: amenityCategories
        .filter((cat: AmenityCategory) => cat.status === 1)
        .map((cat: AmenityCategory) => ({
          value: cat.genCode,
          label: cat.genName,
        })),
      isDisabled: editMode,
    },
    {
      name: "amenityId",
      label: "Amenity",
      type: "select",
      placeholder: "Select amenity",
      required: true,
      colSpan: 3,
      fieldset: "amenityRows",
      dedupSelect: true,
      options: amenities.map((a: Amenity) => ({
        value: a.amenityId,
        label: a.amenityName,
      })),
      isDisabled: true,
    },
    {
      name: "displayOrder",
      label: "Display Order",
      type: "number",
      placeholder: "e.g. 1",
      required: true,
      colSpan: 4,
      fieldset: "amenityRows",
    },
    {
      name: "amenityStatus",
      label: "Status",
      type: "select",
      placeholder: "Status",
      required: true,
      colSpan: 3,
      fieldset: "amenityRows",
      options: STATUS_OPTIONS.map((o) => ({ label: o.label, value: o.value })),
    },
  ];

  const formFieldsets = [
    {
      id: "amenityRows",
      legend: "Amenity Items",
      description: "Add one or more amenities to map under this category.",
      isMultipleEntry: true,
      multipleEntryKey: "amenityRows",
    },
  ];

  // ─── Event Handlers ──────────────────────────────────────────────────────────

  const handleRemoveEntry = (
    _fieldsetId: string,
    _index: number,
    entryValues: Record<string, any>,
  ) => {
    if (!editMode) return;
    if (!entryValues.amenityId) return;

    setRemovedAmenities((prev) => [
      ...prev,
      {
        amenityId: entryValues.amenityId as string,
        displayOrder: Number(entryValues.displayOrder) || 0,
        status: 2,
      },
    ]);
  };

  const handleFormSubmit = async (formData: Record<string, any>) => {
    try {
      const amenityRows = (formData.amenityRows ?? []) as Array<{
        amenityId: string;
        displayOrder: string;
        amenityStatus: string;
      }>;

      const payload = {
        categoryCode: formData.categoryCode as string,
        amenityDetails: [
          ...amenityRows.map((row) => ({
            amenityId: row.amenityId,
            displayOrder: Number(row.displayOrder) || 0,
            status: row.amenityStatus === "1" ? 1 : 0,
          })),
          ...removedAmenities,
        ],
      };

      await postRequest(API_PATH.CATEGORY_AMENITY_MAPPING, payload);

      notifications.show({
        title: "Success",
        message: editMode
          ? COMMON_MESSAGE.AMENITY_MAPPING_UPDATE
          : COMMON_MESSAGE.AMENITY_MAPPING_ADDED,
        color: "green",
      });

      await fetchAllCategoryAmenityMap(amenities);
      setRemovedAmenities([]);
    } catch (error) {
      notifyError(COMMON_MESSAGE.AMENITY_MAPPING_FAIL);
      console.error(COMMON_MESSAGE.AMENITY_MAPPING_FAIL, error);
      return;
    }

    setDrawerOpened(false);
    setEditMode(false);
    setDrawerInitialValues(undefined);
  };

  const handleEdit = (category: (typeof currentCategories)[number]) => {
    setEditMode(true);

    const details = (categoryAmenityMap[category.categoryCode] ?? [])
      .slice()
      .sort(
        (a: CatAmenityDetail, b: CatAmenityDetail) =>
          (a.displayOrder || 999) - (b.displayOrder || 999),
      );

    const amenityRows =
      details.length > 0
        ? details.map((a: CatAmenityDetail) => ({
            amenityId: a.amenityId,
            displayOrder: String(a.displayOrder),
            amenityStatus: a.status === 1 ? "1" : "0",
            isExisting: true,
          }))
        : [{ amenityId: "", displayOrder: "", amenityStatus: "1" }];

    setDrawerInitialValues({
      categoryCode: category.categoryCode ?? "",
      status: category.status === 0 ? "0" : "1",
      amenityRows,
    });

    setDrawerOpened(true);
  };

  const handleAddNew = () => {
    setEditMode(false);
    setDrawerInitialValues(undefined);
    setDrawerOpened(true);
  };

  const handleCloseDrawer = () => {
    setDrawerOpened(false);
    setEditMode(false);
    setDrawerInitialValues(undefined);
    setRemovedAmenities([]);
  };

  // ─── API Calls ───────────────────────────────────────────────────────────────

  const fetchAllCategoryAmenityMap = async (amenitiesList: Amenity[]) => {
    try {
      const res = (await getRequest(
        API_PATH.CATEGORY_AMENITY_MAPPING,
      )) as CatAmenityMapApiResponse;

      const items = res?.data?.data ?? [];
      const map: Record<string, CatAmenityDetail[]> = {};

      items.forEach((item) => {
        map[item.categoryCode] = item.amenityDetails
          .filter((a) => (a.status === 1 || a.status === 0) && a.isAmenityActive === 1)
          .map((a) => {
            const matched = amenitiesList.find(
              (am: Amenity) => am.amenityCode === a.amenityCode,
            );
            return {
              amenityId: matched?.amenityId ?? "",
              amenityName: a.amenityName,
              displayOrder: a.displayOrder,
              status: a.status,
            };
          });
      });

      setCategoryAmenityMap(map);
    } catch (error) {
      notifyError(COMMON_MESSAGE.DATA_FETCH_FAIL);
      console.error(COMMON_MESSAGE.DATA_FETCH_FAIL, error);
    }
  };

  const getAmenities = async (): Promise<Amenity[]> => {
    try {
      const res = (await getRequest(API_PATH.GET_AMENITY)) as AmenityApiResponse;
      const data: Amenity[] = (res?.data?.data ?? []).filter(
        (a: Amenity) => a.status === 1,
      );
      setAmenities(data);
      return data;
    } catch (error) {
      notifyError(COMMON_MESSAGE.DATA_FETCH_FAIL);
      console.error("Error fetching amenities:", error);
      return [];
    }
  };

  const handleCategoryFetch = async (): Promise<AmenityCategory[]> => {
    try {
      const res = (await getRequest(
        `${API_PATH.GET_GEN_CODE}?groupCode=AMENITY_CATEGORY`,
      )) as ApiResponse<AmenityCategory>;
      const categories: AmenityCategory[] = res?.data?.data ?? [];
      setAmenityCategories(categories);
      return categories;
    } catch (error) {
      notifyError(COMMON_MESSAGE.DATA_FETCH_FAIL);
      console.error("Error fetching amenity categories:", error);
      return [];
    }
  };

  // ─── Effects ─────────────────────────────────────────────────────────────────

  useEffect(() => {
    const init = async () => {
      setLoading(true);
      try {
        const [, amenitiesList] = await Promise.all([
          handleCategoryFetch(),
          getAmenities(),
        ]);
        await fetchAllCategoryAmenityMap(amenitiesList);
      } finally {
        setLoading(false);
      }
    };

    init();
  }, []);

  // ─── Render ──────────────────────────────────────────────────────────────────

  return (
    <>
      <AppBreadcrumbs
        items={[
          { label: "Society Management", path: RouteConfig.SOCIETY_MGT },
          {
            label: "Facilities & Amenities",
            path: () => window.history.back(),
          },
          { label: "Amenity Mapping" },
        ]}
      />
      <Container size="xl" pt="md">
        <Box>
          <Stack gap="lg">
            {loading ? (
              Array.from({ length: 3 }).map((_, i) => (
                <Skeleton key={i} height={120} radius="lg" />
              ))
            ) : currentCategories.length === 0 ? (
              <Paper
                radius="lg"
                p="xl"
                bg="white"
                shadow="sm"
                bd={`1px dashed ${theme.colors.gray[3]}`}
              >
                <Center py="xl">
                  <Stack align="center" gap="sm">
                    <IconLayersOff
                      size={48}
                      color={theme.colors.gray[4]}
                      strokeWidth={1.5}
                    />
                    <Text fw={600} size="lg" c="gray.6">
                      No Categories Mapped
                    </Text>
                    <Text size="sm" c="gray.4" ta="center" maw={340}>
                      There are no amenity categories mapped yet. Click{" "}
                      <strong>Map Amenities</strong> to get started.
                    </Text>
                  </Stack>
                </Center>
              </Paper>
            ) : (
              currentCategories.map((category, index) => (
                <CommonCategory
                  key={`${category.categoryCode}-${index}`}
                  title={category.title}
                  amenities={category.amenities}
                  amenityStatuses={category.amenityStatuses}
                  onEdit={() => handleEdit(category)}
                  isChecked={category.status === 1}
                  amenityDisplayOrders={category.amenityDisplayOrders}
                />
              ))
            )}
          </Stack>
        </Box>

        <Button
          leftSection={<IconPlus size={20} />}
          radius="xl"
          size="md"
          style={{
            position: "fixed",
            bottom: 32,
            right: 32,
            zIndex: 100,
            boxShadow: "0 4px 20px rgba(0, 0, 0, 0.15)",
          }}
          color="primary.5"
          onClick={handleAddNew}
        >
          Map Amenities
        </Button>

        <DrawerForm
          opened={drawerOpened}
          onClose={handleCloseDrawer}
          title={editMode ? "Edit Amenity Mapping" : "Map Amenities"}
          fields={formFields}
          fieldsets={formFieldsets}
          onSubmit={handleFormSubmit}
          initialValues={drawerInitialValues}
          size="xl"
          onRemoveEntry={handleRemoveEntry}
        />
      </Container>
    </>
  );
};

export default AmenityMapping;