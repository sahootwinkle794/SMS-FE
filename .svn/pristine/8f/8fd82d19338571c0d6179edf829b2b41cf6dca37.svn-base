export interface SubCategoryListResponse {
    status: number;
    message: string;
    data: {
        page: number;
        limit: number;
        total: number;
        totalPages: number;
        data: SubCategory[];
    };
}

export interface SubCategory {
    subcategoryId: string;
    categoryId: string;
    categoryName: string;
    subcategoryName: string;
    description?: string;
    status?: string;
}

export type SubCategoryFormState = {
    categoryId: string;
    subCategoryName: string;
    description?: string;
    status?: string;
};

export interface ApiError {
    message: string;
    response?: {
        data?: {
            status?: number;
            message?: string;
            data?: unknown[];
        };
    };
}