"use client";

import { DataTable, CustomModal, AccessRestricted } from "@/components";
import type { Column } from "@/components/DataTable";
import { getRequest, postRequest, putRequest, deleteRequest } from "@/service";
import {
  AddRoleApiResponse,
  RoleResponse,
  DeleteRoleResponse,
  RoleListApiResponse,
} from "@/types/superAdmin/setup/roleSetup/roleSetup";
import { API_PATH } from "@/utils/apiPath";
import {
  STATUS_CODE,
  STATUS_OPTIONS,
  STATUS_CONFIG,
  PageTitles,
  RECORDS_PER_PAGE,
} from "../../../../utils/constants";
import {
  Card,
  Flex,
  Grid,
  Select,
  Text,
  TextInput,
  Group,
  Tooltip,
  ActionIcon,
  Button,
  NumberInput,
  Badge,
} from "@mantine/core";
import { useForm } from "@mantine/form";
import { notifications } from "@mantine/notifications";
import {
  IconTrash,
  IconEdit,
  IconCheck,
  IconRestore,
} from "@tabler/icons-react";
import { useCallback, useEffect, useMemo, useState } from "react";
import { IMAGES } from "@/utils/images";
import { useMenuPermissions } from "@/hooks/useMenuPermissions";
import { usePathname } from "next/navigation";
import {
  EditMode,
  ModalState,
} from "@/types/superAdmin/setup/roleSetup/roleSetup";

/* ================= TYPES ================= */

const RoleSetUp = () => {
  const [roles, setRoles] = useState<RoleResponse[]>([]);
  const [isEditMode, setIsEditMode] = useState<EditMode | null>(null);
  const [formKey, setFormKey] = useState(0);
  const [currentPage, setCurrentPage] = useState(1);
  const [totalRecords, setTotalRecords] = useState(0);
  const [loading, setLoading] = useState(false);

  const [modal, setModal] = useState<ModalState>({
    open: false,
    title: "",
    subText: "",
    actionText: "",
    onAction: () => {},
  });

  const { canRead, canWrite } = useMenuPermissions();
  const pathname = usePathname();
  const pageTitle = PageTitles[pathname] ?? "this page";

  /* ================= FORM ================= */

  const form = useForm({
    initialValues: {
      roleCode: null as number | null,
      roleName: "",
      status: "",
    },

    validate: {
      roleCode: (value) =>
        value === null || value === undefined ? "Role Code is required" : null,
      roleName: (value) =>
        value.trim().length === 0 ? "Role Name is required" : null,
      status: (value) =>
        value.trim().length === 0 ? "Status is required" : null,
    },
  });

  /* ================= FETCH ================= */

  const fetchRoles = useCallback(async () => {
    setLoading(true);
    try {
      const response = await getRequest<RoleListApiResponse>(
        API_PATH.GET_ROLES,
        {
          search: "",
          page: currentPage,
          limit: RECORDS_PER_PAGE,
          sortBy: "created_at",
          sortOrder: "DESC",
        },
      );

      setRoles(response.data.data);
      setTotalRecords(response.data.total);
    } catch {
      notifications.show({
        title: "Error!",
        message: "Failed to load roles",
        color: "red",
      });
    } finally {
      setLoading(false);
    }
  }, [currentPage]);

  useEffect(() => {
    fetchRoles();
  }, [fetchRoles]);

  const refreshRoles = useCallback(() => {
    if (currentPage === 1) {
      fetchRoles();
    } else {
      setCurrentPage(1);
    }
  }, [currentPage, fetchRoles]);

  /* ================= CRUD ================= */

  const saveRole = async (values: typeof form.values) => {
    const payload = {
      roleCode: Number(values.roleCode),
      roleName: values.roleName,
      status: Number(values.status),
      createdBy: "admin-user",
    };

    try {
      const url = isEditMode
        ? `${API_PATH.GET_ROLES}/${isEditMode.id}`
        : API_PATH.GET_ROLES;

      const method = isEditMode ? putRequest : postRequest;

      const response = await method<typeof payload, AddRoleApiResponse>(
        url,
        payload,
      );

      if (
        response?.data ||
        response?.status === STATUS_CODE.SUCCESS ||
        response?.status === STATUS_CODE.CREATED
      ) {
        notifications.show({
          title: "Successful!",
          message: isEditMode
            ? "Role updated successfully"
            : "Role added successfully",
          color: "green",
        });

        form.reset();
        setIsEditMode(null);
        setFormKey((k) => k + 1);
        refreshRoles();
      }
    } catch (err: unknown) {
      notifications.show({
        title: "Error",
        message: (err as { message: string }).message || "Something went wrong",
        color: "red",
      });
    }
  };

  const deleteRow = useCallback(
    async (roleId: string) => {
      try {
        const response = await deleteRequest<DeleteRoleResponse>(
          `${API_PATH.GET_ROLES}/${roleId}`,
        );

        if (response?.status === STATUS_CODE.SUCCESS) {
          notifications.show({
            title: "Successful!",
            message: "Role Deleted",
            color: "green",
          });
          refreshRoles();
        }
      } catch {
        notifications.show({
          title: "Error!",
          message: "Failed to delete role",
          color: "red",
        });
      }
    },
    [refreshRoles],
  );

  const openDeleteModal = useCallback(
    (roleId: string) => {
      setModal({
        open: true,
        title: "Confirm Deletion",
        subText: "Are you sure you want to delete this role?",
        actionText: "Yes, Delete",
        onAction: () => {
          deleteRow(roleId);
          setModal((p) => ({ ...p, open: false }));
        },
      });
    },
    [deleteRow],
  );

  const getParticularRoleId = useCallback(async (roleId: string) => {
    try {
      const response = await getRequest<{ data: RoleResponse }>(
        `${API_PATH.GET_ROLES}/${roleId}`,
      );

      const role = response.data;

      form.setValues({
        roleCode: role.roleCode,
        roleName: role.roleName,
        status: String(role.status),
      });
    } catch {
      notifications.show({
        title: "Error!",
        message: "Failed to fetch role",
        color: "red",
      });
    }
  }, []);

  const handleSubmit = (values: typeof form.values) => {
    saveRole(values);
  };

  const handleReset = useCallback(() => {
    form.reset();
    setIsEditMode(null);
    setFormKey((k) => k + 1);
  }, []);

  /* ================= COLUMNS ================= */

  const actionColumn = useMemo<Column<RoleResponse>>(
    () => ({
      header: "Actions",
      accessor: "id",
      render: (_value, row) => {
        const id = row.id;

        return (
          <Group justify="center" gap={8}>
            <Tooltip label="Edit Role">
              <ActionIcon
                color="blue"
                variant="light"
                onClick={() => {
                  setIsEditMode({ id, isEdit: true });
                  getParticularRoleId(id);
                }}
              >
                <IconEdit size={16} />
              </ActionIcon>
            </Tooltip>

            <Tooltip label="Delete Role">
              <ActionIcon
                color="red"
                variant="light"
                onClick={() => openDeleteModal(id)}
              >
                <IconTrash size={16} />
              </ActionIcon>
            </Tooltip>
          </Group>
        );
      },
    }),
    [getParticularRoleId, openDeleteModal],
  );

  const columns: Column<RoleResponse>[] = useMemo(
    () => [
      {
        header: "Sl. No",
        accessor: "id",
        render: (_v, _r, index) => (
          <Text>{(currentPage - 1) * RECORDS_PER_PAGE + index + 1}</Text>
        ),
      },
      ...(canWrite ? [actionColumn] : []),
      {
        header: "Role Code",
        accessor: "roleCode",
        sortable: true,
      },
      {
        header: "Role Name",
        accessor: "roleName",
        sortable: true,
      },
      {
        header: "Status",
        accessor: "status",
        render: (value) => {
          const status = Number(value) as 0 | 1;
          return (
            <Badge color={STATUS_CONFIG[status]?.color}>
              {STATUS_CONFIG[status]?.label}
            </Badge>
          );
        },
      },
      {
        header: "Created By",
        accessor: "createdBy",
      },
      {
        header: "Created At",
        accessor: "createdAt",
        render: (value) =>
          value
            ? new Date(value).toLocaleString("en-IN", {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
              })
            : "-",
      },
    ],
    [currentPage, canWrite, actionColumn],
  );

  /* ================= ACCESS ================= */

  if (!canRead && !canWrite) {
    return <AccessRestricted pageTitle={pageTitle} />;
  }

  /* ================= UI ================= */

  return (
    <>
      <Grid>
        <Grid.Col span={canWrite ? 9 : 12}>
          <DataTable
            data={roles}
            columns={columns}
            pageSize={RECORDS_PER_PAGE}
            currentPage={currentPage}
            onPageChange={setCurrentPage}
            totalRecords={totalRecords}
            loading={loading}
          />
        </Grid.Col>

        {canWrite && (
          <Grid.Col span={3}>
            <Card shadow="sm" padding="lg" withBorder>
              <Card.Section withBorder inheritPadding py="xs" mb="md">
                <strong>{isEditMode ? "Update Role" : "Add Role"}</strong>
              </Card.Section>

              <form onSubmit={form.onSubmit(handleSubmit)}>
                <NumberInput
                  key={formKey}
                  label="Role Code"
                  min={1}
                  withAsterisk
                  {...form.getInputProps("roleCode")}
                  disabled={isEditMode?.isEdit ?? false}
                />

                <TextInput
                  mt="xs"
                  label="Role Name"
                  withAsterisk
                  {...form.getInputProps("roleName")}
                />

                <Select
                  mt="xs"
                  label="Status"
                  data={STATUS_OPTIONS}
                  placeholder="Select status"
                  value={form.values.status || null}
                  onChange={(v) => form.setFieldValue("status", v || "")}
                  error={form.errors.status}
                  withAsterisk
                  clearable
                />

                <Flex justify="flex-end" gap="sm">
                  <Button
                    mt="md"
                    variant="outline"
                    color="primary.5"
                    leftSection={<IconRestore size={16} />}
                    onClick={handleReset}
                  >
                    Reset
                  </Button>

                  <Button
                    mt="md"
                    type="submit"
                    color="primary.5"
                    leftSection={<IconCheck size={16} />}
                  >
                    {isEditMode ? "Update" : "Submit"}
                  </Button>
                </Flex>
              </form>
            </Card>
          </Grid.Col>
        )}
      </Grid>

      <CustomModal
        opened={modal.open}
        onClose={() => setModal((p) => ({ ...p, open: false }))}
        icon={IMAGES.WARNING}
        title={modal.title}
        subtext={modal.subText}
        actionText={modal.actionText}
        onAction={modal.onAction}
        showCancel
        cancelText="No"
      />
    </>
  );
};

export default RoleSetUp;
