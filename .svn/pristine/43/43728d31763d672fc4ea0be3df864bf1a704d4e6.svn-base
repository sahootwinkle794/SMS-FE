"use client";

import {
  Container,
  Grid,
  Box,
  Title,
  Card,
  Text,
  Button,
  Group,
  Image,
} from "@mantine/core";
import { Carousel } from "@mantine/carousel";
import "@mantine/carousel/styles.css";
import { COLORS } from "../../constants";
import { IMAGE } from "../../assets/utils/images";
import Autoplay from "embla-carousel-autoplay";
import { useIntersection } from "@mantine/hooks";
import { useRef, useState } from "react";
import { EmblaCarouselType } from "embla-carousel";

export default function FeaturesSection() {
  // const ref = useRef(null);

  const { ref: intersectionRef, entry } = useIntersection({
    root: null,
    threshold: 0.3,
  });
  const autoplay = useRef(Autoplay({ delay: 3000, stopOnInteraction: false }));

  const [embla, setEmbla] = useState<EmblaCarouselType | null>(null);

  const scrollPrev = () => embla?.scrollPrev();
  const scrollNext = () => embla?.scrollNext();

  return (
    <Box
      className="feature"
      id="features"
      pt={80}
      style={{ backgroundColor: COLORS.lightBg }}
    >
      <Container size="xl" className="feature-con ">
        <Grid>
          <Grid.Col span={{ base: 12, md: 4 }}>
            <div ref={intersectionRef}>
              <Title
                order={4}
                fw={400}
                className={`feature-title scroll-animate ${
                  entry?.isIntersecting ? "show" : ""
                }`}
              >
                Why SMS?
              </Title>

              <Title
                order={3}
                fw={100}
                className={`feature-title2 scroll-animate ${
                  entry?.isIntersecting ? "show" : ""
                }`}
              >
                One Platform.
              </Title>

              <Title
                order={3}
                fw={600}
                className={`feature-title2 scroll-animate ${
                  entry?.isIntersecting ? "show" : ""
                }`}
              >
                Three Experiences.
                <br /> Zero Complexity.
              </Title>

              <Title
                order={4}
                className={`feature-title3 scroll-animate ${
                  entry?.isIntersecting ? "show" : ""
                }`}
              >
                Every society is different — so why use a one-size-fits-all
                solution?
              </Title>

              <Title
                order={6}
                fw={400}
                className={`feature-title4 scroll-animate ${
                  entry?.isIntersecting ? "show" : ""
                }`}
              >
                SMS adapts automatically for High-End, Mid-End, and Low-End
                societies.
              </Title>

              {/* CUSTOM BUTTONS */}
              <Group mt="lg">
                <Button
                  onClick={scrollPrev}
                  variant="outline"
                  className="control-btn"
                >
                  <Image
                    src={IMAGE.LEFT_ARROW}
                    alt="left-arrow"
                    className="arrow-icon"
                  />
                </Button>
                <Button
                  onClick={scrollNext}
                  variant="outline"
                  className="control-btn"
                >
                  <Image
                    src={IMAGE.RIGHT_ARROW}
                    alt="right-arrow"
                    className="arrow-icon"
                  />
                </Button>
              </Group>
            </div>
          </Grid.Col>
          <Grid.Col span={{ base: 12, md: 8 }}>
            <Carousel
              getEmblaApi={setEmbla}
              withControls={false} // remove default arrows
              withIndicators={false} // optional
              height={370}
              slideSize="33.333333%"
              slideGap="md"
              plugins={[autoplay.current]}
              emblaOptions={{
                loop: true,
                align: "start",
                slidesToScroll: 1,
              }}
              onMouseEnter={autoplay.current.stop}
              onMouseLeave={autoplay.current.reset}
            >
              <Carousel.Slide>
                <Card
                  shadow="sm"
                  padding="lg"
                  radius="md"
                  withBorder
                  className="featureCard"
                >
                  <Group justify="space-between" mt="md" mb="xs">
                    <Image
                      src={IMAGE.ICON_FEATURE_ONE}
                      alt="iconFeatureOne"
                      className="feature-icon"
                    />
                    <Text size="xl" fw={700} className="Feature-card-text">
                      Simplifies daily operations
                    </Text>
                  </Group>

                  <Text size="sm" c="dimmed" className="feature-p">
                    Create fast, responsive websites that hook visitors and push
                    them down the conversion pipeline.
                  </Text>
                </Card>
              </Carousel.Slide>
              <Carousel.Slide>
                <Card
                  shadow="sm"
                  padding="lg"
                  radius="md"
                  withBorder
                  className="featureCard"
                >
                  <Group justify="space-between" mt="md" mb="xs">
                    <Image
                      src={IMAGE.ICON_FEATURE_TWO}
                      alt="iconFeatureOne"
                      className="feature-icon"
                    />
                    <Text size="xl" fw={700} className="Feature-card-text">
                      Automates finances & communication
                    </Text>
                  </Group>

                  <Text size="sm" c="dimmed" className="feature-p">
                    Build custom applications that automate staff tasks, meet
                    regulatory requirements, and improve service delivery.
                  </Text>
                </Card>
              </Carousel.Slide>
              <Carousel.Slide>
                <Card
                  shadow="sm"
                  padding="lg"
                  radius="md"
                  withBorder
                  className="featureCard"
                >
                  <Group justify="space-between" mt="md" mb="xs">
                    <Image
                      src={IMAGE.ICON_FEATURE_THREE}
                      alt="iconFeatureOne"
                      className="feature-icon"
                    />
                    <Text size="xl" fw={700} className="Feature-card-text">
                      Strengthens Security
                    </Text>
                  </Group>

                  <Text size="sm" c="dimmed" className="feature-p">
                    Turn data into insights to make smarter business decisions.
                  </Text>
                </Card>
              </Carousel.Slide>
              <Carousel.Slide>
                <Card
                  shadow="sm"
                  padding="lg"
                  radius="md"
                  withBorder
                  className="featureCard"
                >
                  <Group justify="space-between" mt="md" mb="xs">
                    <Image
                      src={IMAGE.ICON_FEATURE_ONE}
                      alt="iconFeatureOne"
                      className="feature-icon"
                    />
                    <Text size="xl" fw={700} className="Feature-card-text">
                      Simplifies daily operations
                    </Text>
                  </Group>

                  <Text size="sm" c="dimmed" className="feature-p">
                    Create fast, responsive websites that hook visitors and push
                    them down the conversion pipeline.
                  </Text>
                </Card>
              </Carousel.Slide>
              <Carousel.Slide>
                <Card
                  shadow="sm"
                  padding="lg"
                  radius="md"
                  withBorder
                  className="featureCard"
                >
                  <Group justify="space-between" mt="md" mb="xs">
                    <Image
                      src={IMAGE.ICON_FEATURE_TWO}
                      alt="iconFeatureOne"
                      className="feature-icon"
                    />
                    <Text size="xl" fw={700} className="Feature-card-text">
                      Simplifies daily operations
                    </Text>
                  </Group>

                  <Text size="sm" c="dimmed" className="feature-p">
                    Create fast, responsive websites that hook visitors and push
                    them down the conversion pipeline.
                  </Text>
                </Card>
              </Carousel.Slide>
            </Carousel>
          </Grid.Col>
        </Grid>
      </Container>
      <Image src={IMAGE.FEATURE_ART} alt="Feature Art" />
    </Box>
  );
}
