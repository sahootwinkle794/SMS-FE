"use client";

import {
  Container,
  Grid,
  Stack,
  Box,
  Title,
  Button,
  Image,
} from "@mantine/core";
import { COLORS } from "../../constants";
import { Carousel } from "@mantine/carousel";
import { IMAGE } from "../../assets/utils/images";
import Autoplay from "embla-carousel-autoplay";
import {useEffect, useRef } from "react";

export default function ServicesSection() {
  useEffect(() => {
    const elements = document.querySelectorAll(".scroll-animate");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          } else {
            entry.target.classList.remove("active");
          }
        });
      },
      { threshold: 0.2 },
    );

    elements.forEach((el) => observer.observe(el));

    return () => observer.disconnect();
  }, []);
  const autoplay = useRef(Autoplay({ delay: 4000 }));

  return (
    <Box
      className="service"
      id="services"
      style={{
        position: "relative",
      }}
    >
      <Container size="xl" id="feature">
        <Grid gutter={60} align="center">
          <Grid.Col span={{ base: 12, md: 6 }} className="serve-one">
            <Stack gap="xl" className="serve-stack">
              <Title
                order={2}
                size={32}
                fw={600}
                c="white"
                className="serve-head scroll-animate"
              >
                WHO WE SERVE ?
              </Title>
              <Stack gap="md">
                <Image
                  src={IMAGE.ICON_SERVE_ONE}
                  alt="iconServeOne"
                  className="who-icon"
                />
                <Title className="who-title scroll-animate">High-End Societies</Title>
                <Title className="who-p scroll-animate" textWrap="balance">
                  Smart home integrations, concierge services, valet management,
                  premium amenities, and luxury-grade UX.
                </Title>
              </Stack>
              <Stack gap="md">
                <Image
                  src={IMAGE.ICON_SERVE_TWO}
                  alt="iconServeTwo"
                  className="who-icon"
                />
                <Title className="who-title scroll-animate">Mid-End Societies</Title>
                <Title className="who-p scroll-animate" textWrap="balance">
                  Maintenance billing, payments, announcements, polls, visitor
                  management, and community engagement tools.
                </Title>
              </Stack>
              <Stack gap="md">
                <Image
                  src={IMAGE.ICON_SERVE_THREE}
                  alt="iconServeThree"
                  className="who-icon"
                />
                <Title className="who-title scroll-animate">Low-End Societies</Title>
                <Title className="who-p scroll-animate" textWrap="balance">
                  Free communication, basic payments, digital notice board,
                  simple complaint tracking, and visitor alerts.
                </Title>
              </Stack>
              <Button
                size="lg"
                style={{
                  backgroundColor: COLORS.accent,
                  width: "fit-content",
                }}
                variant="gradient"
                gradient={{ from: "#FF7853", to: "#FC2631", deg: 180 }}
                className="who-btn scroll-animate"
              >
                View All Features
              </Button>
            </Stack>
          </Grid.Col>
          <Grid.Col span={{ base: 12, md: 6 }} className="serve-two">
            <Carousel
              withIndicators
              height={600}
              plugins={[autoplay.current]}
              onMouseEnter={autoplay.current.stop}
              onMouseLeave={autoplay.current.reset}
              emblaOptions={{
                loop: true,
                align: "start",
                slidesToScroll: 1,
                dragFree: false,
              }}
              styles={{
                control: {
                  backgroundColor: "red",
                  color: "white",
                },

                indicator: {
                  backgroundColor: "red",
                },
              }}
            >
              <Carousel.Slide>
                <Title className="serve-title1 scroll-animate">Core Highlight</Title>
                <Title className="serve-title2 scroll-animate">
                  One App for Residents. Three Panels for Admins. One Central
                  Dashboard for Site Managers.
                </Title>
                <Image
                  src={IMAGE.DASH_BOARD}
                  alt="dashBoard"
                  className="dashboard-img"
                />
                <Title className="serve-title2 scroll-animate">
                  Automated Billing & Online Payments
                </Title>
              </Carousel.Slide>
              <Carousel.Slide>
                <Title className="serve-title1 scroll-animate">Core Highlight</Title>
                <Title className="serve-title2 scroll-animate">
                  One App for Residents. Three Panels for Admins. One Central
                  Dashboard for Site Managers.
                </Title>
                <Image
                  src={IMAGE.DASH_BOARD}
                  alt="dashBoard"
                  className="dashboard-img"
                />
                <Title className="serve-title2 scroll-animate">
                  Automated Billing & Online Payments
                </Title>
              </Carousel.Slide>
              <Carousel.Slide>
                <Title className="serve-title1 scroll-animate">Core Highlight</Title>
                <Title className="serve-title2 scroll-animate">
                  One App for Residents. Three Panels for Admins. One Central
                  Dashboard for Site Managers.
                </Title>
                <Image
                  src={IMAGE.DASH_BOARD}
                  alt="dashBoard"
                  className="dashboard-img"
                />
                <Title className="serve-title2 scroll-animate">
                  Automated Billing & Online Payments
                </Title>
              </Carousel.Slide>
            </Carousel>
          </Grid.Col>
        </Grid>
      </Container>
    </Box>
  );
}
