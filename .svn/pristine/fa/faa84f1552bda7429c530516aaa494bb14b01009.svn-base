// ─── API shapes ───────────────────────────────────────────────────────────────

export interface ServiceApiItem {
  serviceId: string;
  serviceName: string;
  iconUrl: string;
  displayOrder: number;
  isAccess: 0 | 1;
}

export interface ServicesApiResponse {
  data: {
    data: {
      societyId: string;
      services: ServiceApiItem[];
    };
  };
}