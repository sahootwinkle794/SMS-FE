// ─── Enums ────────────────────────────────────────────────────────────────────

export type VehicleType   = "4-wheeler" | "2-wheeler";
export type VehicleStatus = "active" | "inactive";

// ─── A single vehicle entry ───────────────────────────────────────────────────

export interface VehicleEntry {
  vehicleId: string;
  vehicleNumber: string;
  vehicleModel: string;
  vehicleType: VehicleType;
  vehicleImageUrl?: string;
  status: VehicleStatus;
}

// ─── A resident with their vehicles ──────────────────────────────────────────

export interface ResidentVehicleRecord {
  recordId: string;          // unique per resident
  residentId: string;
  residentName: string;
  registeredDate: string;
  vehicles: VehicleEntry[];
}

// ─── Form values ──────────────────────────────────────────────────────────────

export interface VehicleEntryForm {
  vehicleId?: string;        // present when editing an existing vehicle
  vehicleNumber: string;
  vehicleModel: string;
  vehicleType: VehicleType | "";
  vehicleImageUrl?: string;
  status: VehicleStatus;
}

export interface ResidentVehicleFormValues {
  recordId?: string;
  residentId: string;
  residentName: string;
  vehicles: VehicleEntryForm[];
}

// ─── Resident option for the dropdown ────────────────────────────────────────

export interface ResidentOption {
  value: string;   // residentId
  label: string;   // residentName
}

