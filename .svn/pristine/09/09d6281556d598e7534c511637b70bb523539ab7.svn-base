"use client";
import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  ActionIcon,
  Affix,
  Badge,
  Box,
  Button,
  Flex,
  Group,
  Select,
  Stack,
  Text,
  TextInput,
  Tooltip,
} from "@mantine/core";
import { IconEdit, IconPlus, IconSearch, IconTrash } from "@tabler/icons-react";
import { AppBreadcrumbs, CustomModal } from "@/components";
import { RouteConfig } from "@/utils/routeConfig";
import { DataTable, Column } from "@/components/DataTable";
import { DrawerForm } from "@/components/DrawerForm";
import {
  FieldsetConfig,
  Field,
  LookupResult,
} from "@/components/DrawerForm/DrawerForm";
import { getRequest, postRequest, patchRequest } from "@/service";
import { API_PATH } from "@/utils/apiPath";
import { IMAGES } from "@/utils/images";
import { notifications } from "@mantine/notifications";
import {
  AddSocietyPayload,
  SocietyApiResponse,
  SocietyItem,
  SocietyMasterItem,
  StateMasterApiResponse,
  DistrictMasterApiResponse,
  DistrictMasterItem,
  SocietyDetailResponse,
  SocietyFormValues,
  BlockFormInfo,
  FormInstance,
  ApiError,
  AdminLookupEntry,
  AdminDetailFromApi,
} from "@/types/admin/societyManagement/newSociety/newSociety";
import {
  PackageApiResponse,
  PackageItem,
} from "@/types/admin/societyManagement/packageSetup/packageSetup";
import { useSocietyLevels } from "@/hooks/useSocietyLevels";
import {
  COMMON_MESSAGE,
  REGEX,
  REGEX_MSG,
  STATUS_OPTIONS,
  RECORDS_PER_PAGE,
  STATUS_CONFIG,
} from "@/utils/constants";

// ── Helpers ───────────────────────────────────────────────────────────────────

const notifyError = (message: string) =>
  notifications.show({ title: "Error", message, color: "red" });

const notifySuccess = (message: string) =>
  notifications.show({ title: "Successful!", message, color: "green" });

// ── Types ─────────────────────────────────────────────────────────────────────

// ── Component ─────────────────────────────────────────────────────────────────

const NewSociety = () => {
  const [currentPage, setCurrentPage] = useState(1);
  const [drawerOpened, setDrawerOpened] = useState(false);
  const [editMode, setEditMode] = useState(false);
  const [loading, setLoading] = useState(false);
  const [selectedSociety, setSelectedSociety] =
    useState<SocietyDetailResponse | null>(null);
  const [societyData, setSocietyData] = useState<SocietyItem[]>([]);
  const [totalRecords, setTotalRecords] = useState(0);
  const [packages, setPackages] = useState<PackageItem[]>([]);
  const [stateData, setStateData] = useState<SocietyMasterItem[]>([]);
  const [districtData, setDistrictData] = useState<DistrictMasterItem[]>([]);
  const [deleteModalOpen, setDeleteModalOpen] = useState(false);
  const [searchName, setSearchName] = useState("");
  const [filters, setFilters] = useState<{
    status: string | null;
    societyLevel: string | null;
  }>({
    status: null,
    societyLevel: null,
  });

  // ── Ref to store valid admin lookup data (keyed by row index) ─────────────
  // Using a ref instead of state to avoid re-renders that wipe lookup result display
  const adminLookupData = useRef<Record<number, AdminLookupEntry>>({});

  // Pre-seeded lookup result cards shown in DrawerForm on edit open
  const [initialLookupResults, setInitialLookupResults] = useState<
    Record<string, LookupResult>
  >({});

  const { levels } = useSocietyLevels();
  console.log(initialLookupResults);

  // ── Derived / memoized options ────────────────────────────────────────────

  const packageOptions = useMemo(
    () => packages.map((p) => ({ value: p.id, label: p.packageName })),
    [packages],
  );

  const stateOptions = useMemo(
    () =>
      stateData.map((s) => ({
        label: s.stateName,
        value: s.stateCode.toString(),
      })),
    [stateData],
  );

  const districtOptions = useMemo(
    () =>
      districtData.map((d) => ({
        label: d.districtName,
        value: d.districtCode.toString(),
      })),
    [districtData],
  );

  const levelOptions = useMemo(
    () =>
      levels.map((l) => ({
        value: l.societyLevelId,
        label: l.levelName,
        levelCode: l.levelCode,
      })),
    [levels],
  );

  const selectedLevel = useMemo(
    () => levels.find((l) => l.societyLevelId === filters.societyLevel),
    [levels, filters.societyLevel],
  );

  const getLevelCode = useCallback(
    (societyLevelId: string) =>
      levels.find((l) => l.societyLevelId === societyLevelId)?.levelCode || "",
    [levels],
  );

  // ── Data fetchers ─────────────────────────────────────────────────────────

  const fetchPackage = useCallback(async () => {
    setLoading(true);
    try {
      const response = await getRequest<PackageApiResponse>(
        API_PATH.GET_PACKAGE,
      );
      setPackages(response?.data?.data);
    } catch (err) {
      console.error(err);
      notifyError("Failed to Packages");
    } finally {
      setLoading(false);
    }
  }, []);

  const getStateMaster = useCallback(async () => {
    setLoading(true);
    try {
      const response = await getRequest<StateMasterApiResponse>(
        API_PATH.GET_STATE_MASTER,
      );
      setStateData(response?.data?.data);
    } catch (err) {
      console.error(err);
      notifyError("Failed to load states");
    } finally {
      setLoading(false);
    }
  }, []);

  const getDistrictMaster = useCallback(async (stateCode: number) => {
    try {
      const response = await getRequest<DistrictMasterApiResponse>(
        `${API_PATH.GET_DISTRICT_MASTER}/${stateCode}`,
      );
      setDistrictData(response.data);
    } catch (err) {
      console.error(err);
    }
  }, []);

  const fetchSocietyById = useCallback(async (id: string) => {
    try {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const response = await getRequest<any>(`${API_PATH.GET_SOCITIES}/${id}`);
      return response?.data;
    } catch (err: unknown) {
      const error = err as ApiError;
      notifyError(
        error?.response?.data?.message || COMMON_MESSAGE.SOCIETY_FETCH_FAIL,
      );
    }
  }, []);

  const fetchSocietyDetails = useCallback(async () => {
    setLoading(true);
    try {
      const response = await getRequest<SocietyApiResponse>(
        API_PATH.GET_SOCITIES,
        {
          search: searchName,
          page: currentPage,
          limit: RECORDS_PER_PAGE,
          sortBy: "createdAt",
          sortOrder: "DESC",
          ...(filters.status && { status: Number(filters.status) }),
          ...(selectedLevel?.levelCode && {
            societyLevel: selectedLevel.levelCode,
          }),
        },
      );
      setSocietyData(response?.data?.data);
      setTotalRecords(response?.data?.total);
    } catch (err) {
      const error = err as ApiError;
      notifyError(
        error?.response?.data?.message || COMMON_MESSAGE.SOCIETY_FETCH_FAIL,
      );
    } finally {
      setLoading(false);
    }
  }, [currentPage, searchName, filters, selectedLevel?.levelCode]);

  useEffect(() => {
    fetchPackage();
    getStateMaster();
  }, [fetchPackage, getStateMaster]);

  useEffect(() => {
    const timer = setTimeout(() => fetchSocietyDetails(), 500);
    return () => clearTimeout(timer);
  }, [fetchSocietyDetails]);

  // ── CRUD handlers ─────────────────────────────────────────────────────────

  const handleDeleteClick = (row: SocietyItem) => {
    setSelectedSociety({
      societyId: row.societyId,
      societyName: row.societyName,
      societyCode: row.societyCode,
      registrationNumber: row.registrationNumber,
      societyType: row.societyType,
      societyLevel: row.societyLevel,
      establishmentYear: row.establishmentYear,
      totalArea: row.totalArea,
      blocks: [],
      addressLine1: row.addressLine1,
      areaLocality: row.areaLocality,
      city: row.city,
      districtCode: row.district,
      stateCode: row.state,
      pincode: row.pincode,
      landmark: row.landmark,
      adminName: row.adminName,
      adminMobile: row.adminMobile,
      adminEmail: row.adminEmail,
      packageId: row.packageId,
      status: Number(row.status),
      adminDetails: [],
    });
    setDeleteModalOpen(true);
  };

  const handleConfirmDelete = async () => {
    if (!selectedSociety?.societyId) return;
    try {
      await patchRequest(
        `${API_PATH.GET_SOCITIES}/${selectedSociety.societyId}`,
        {
          status: selectedSociety.status === 1 ? 2 : 1,
        },
      );
      fetchSocietyDetails();
    } catch (err: unknown) {
      const error = err as ApiError;
      notifyError(
        error.response?.data?.message ||
          error.message ||
          "Something went wrong",
      );
    }
    setDeleteModalOpen(false);
    setSelectedSociety(null);
  };

  const createSociety = async (payload: AddSocietyPayload) => {
    try {
      const response = await postRequest(API_PATH.GET_SOCITIES, payload);
      notifySuccess(COMMON_MESSAGE.SOCIETY_ADDED);
      return response;
    } catch (err: unknown) {
      console.log("err", err);
      const error = err as ApiError;
      notifyError(
        error?.response?.data?.message ||
          COMMON_MESSAGE.SOCIETY_CREATION_FAILED,
      );
      throw err;
    }
  };

  const updateSociety = async (id: string, payload: AddSocietyPayload) => {
    try {
      const response = await patchRequest(
        `${API_PATH.GET_SOCITIES}/${id}`,
        payload,
      );
      notifySuccess(COMMON_MESSAGE.SOCIETY_UPDATE);
      return response;
    } catch (err: unknown) {
      const error = err as ApiError;
      notifyError(error?.response?.data?.message || "Failed to update");
    }
  };

  // ── User lookup ───────────────────────────────────────────────────────────

  const fetchUserByMobile = async (mobile: string): Promise<LookupResult> => {
    try {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const response = await getRequest<any>(
        `${API_PATH.USER_LOOKUP_BY_MOBILE}?mobNumber=${mobile}`,
      );
      const data = response?.data;

      return {
        success: true,
        data: {
          userId: data.userId,
          roleId: data.roleId,
          name: data.userName,
          role: data.roleName,
          email: data.email,
        },
      };
    } catch (err: unknown) {
      const error = err as ApiError;
      const message =
        error?.response?.data?.message || error?.message || "User not found";
      return { success: false, error: message };
    }
  };

  // ── Transformers ──────────────────────────────────────────────────────────

  const transformToPayload = (
    values: SocietyFormValues,
    isEdit = false,
  ): AddSocietyPayload => {
    const blocks =
      values.blocks?.map((block: BlockFormInfo) => {
        const blockData: {
          blockName: string;
          numberOfBuildings: number;
          numberOfFloors: number;
          totalFlats: number;
          parkingSlots: number;
          blockCode?: string;
        } = {
          blockName: block.blockName || "",
          numberOfBuildings: Number(block.numberOfBuildings) || 0,
          numberOfFloors: Number(block.numberOfFloors) || 0,
          totalFlats: Number(block.totalFlats) || 0,
          parkingSlots: Number(block.parkingSlots) || 0,
        };
        if (isEdit && block.blockCode) blockData.blockCode = block.blockCode;
        return blockData;
      }) || [];

    // Only include entries that had a successful lookup (exist in ref)
    const adminDetails: AdminLookupEntry[] = Object.values(
      adminLookupData.current,
    );

    return {
      societyName: values.societyName,
      societyCode: values.societyCode,
      registrationNumber: values.registrationNumber,
      societyType: values.societyType?.toUpperCase(),
      societyLevelId: values.societyLevelId,
      societyLevelCode: getLevelCode(values.societyLevelId),
      establishmentYear: Number(values.establishmentYear),
      totalArea: Number(values.totalArea) || 0,
      numberOfBlocks: blocks.length,
      blocks,
      addressLine1: values.addressLine1,
      areaLocality: values.areaLocality,
      city: values.city,
      districtCode: values.districtCode,
      stateCode: values.stateCode,
      pincode: values?.pincode?.toString(),
      landmark: values.landmark,
      adminDetails,
      packageId: values.packageId,
      status:
        values.status !== undefined && values.status !== ""
          ? Number(values.status)
          : 1,
    };
  };

  const mapSocietyToForm = (data: SocietyDetailResponse): SocietyFormValues => {
    const defaultBlock: BlockFormInfo = {
      blockName: "",
      numberOfBuildings: "",
      numberOfFloors: "",
      totalFlats: "",
      parkingSlots: "",
    };

    const mappedBlocks: BlockFormInfo[] = data.blocks?.length
      ? data.blocks.map(
          (block): BlockFormInfo => ({
            blockCode: block.blockCode ?? "",
            blockName: block.blockName ?? "",
            numberOfBuildings: block.numberOfBuildings?.toString() ?? "",
            numberOfFloors: block.numberOfFloors?.toString() ?? "",
            totalFlats: block.totalFlats?.toString() ?? "",
            parkingSlots: block.parkingSlots?.toString() ?? "",
          }),
        )
      : [defaultBlock];

    // Map adminDetails into adminInfo form rows — only adminMobile renders in
    // the field; name/email are shown via pre-seeded lookupResults in DrawerForm
    const mappedAdminInfo = data.adminDetails?.length
      ? data.adminDetails.map((admin: AdminDetailFromApi) => ({
          adminMobile: admin.mobile || "",
        }))
      : [{ adminMobile: "" }];

    return {
      societyName: data.societyName || "",
      societyCode: data.societyCode || "",
      registrationNumber: data.registrationNumber || "",
      totalArea: data.totalArea || "",
      establishmentYear: data.establishmentYear?.toString() || "",
      societyType: data.societyType?.toLowerCase() || "",
      societyLevelId:
        levels.find((l) => l.levelCode === data.societyLevel)?.societyLevelId ||
        "",
      addressLine1: data.addressLine1 || "",
      areaLocality: data.areaLocality || "",
      stateCode: data.stateCode?.toString() || "",
      districtCode: data.districtCode?.toString() || "",
      city: data.city || "",
      pincode: data.pincode || "",
      landmark: data.landmark || "",
      packageId: data.packageId || "",
      status: data.status?.toString() || "1",
      blocks: mappedBlocks,
      adminInfo: mappedAdminInfo,
    };
  };

  // ── Fieldset config ───────────────────────────────────────────────────────

  const fieldsetConfigs: FieldsetConfig[] = [
    {
      id: "basicInfo",
      legend: "Basic Society Information",
      description: "Core identification details of the society",
    },
    {
      id: "location",
      legend: "Location Details",
      description: "Address and geographical information",
    },
    {
      id: "building",
      legend: "Building & Unit Information",
      description: "Structural details of the society",
      isMultipleEntry: true,
      multipleEntryKey: "blocks",
    },
    {
      id: "adminInfo",
      legend: "Admin Information",
      description: "Administrative contact details",
      isMultipleEntry: true,
      multipleEntryKey: "adminInfo",
    },
    {
      id: "status",
      legend: "Status & Control",
      description: "Society lifecycle and control settings",
    },
  ];

  // ── Form fields ───────────────────────────────────────────────────────────

  const formFields: Field[] = [
    /* ── Basic Info ── */
    {
      name: "societyName",
      label: "Society Name",
      placeholder: "Enter society name",
      type: "text",
      required: true,
      fieldset: "basicInfo",
      colSpan: 6,
      minLength: 3,
      maxLength: 100,
      regex: REGEX.NAME,
      regexMessage: REGEX_MSG.NAME,
      liveValidation: true,
    },
    {
      name: "societyCode",
      label: "Society Code",
      placeholder: "Enter society code",
      type: "text",
      required: true,
      fieldset: "basicInfo",
      isDisabled: editMode,
      colSpan: 3,
      maxLength: 20,
      regex: REGEX.SOCIETY_CODE,
      regexMessage: REGEX_MSG.SOCIETY_NAME,
      liveValidation: true,
    },
    {
      name: "registrationNumber",
      label: "Registration Number",
      placeholder: "Enter registration number",
      type: "text",
      required: true,
      isDisabled: editMode,
      fieldset: "basicInfo",
      colSpan: 3,
      regex: REGEX.REGISTRATION_NUM,
      regexMessage: REGEX_MSG.REGISTRATION_NUM,
      liveValidation: true,
    },
    {
      name: "totalArea",
      label: "Total Area",
      placeholder: "Enter total area",
      type: "text",
      required: true,
      fieldset: "basicInfo",
      colSpan: 3,
      regex: /^\d+(\.\d{1,2})?$/,
      regexMessage: "Enter valid area (numbers with up to 2 decimals).",
      liveValidation: true,
    },
    {
      name: "establishmentYear",
      label: "Establishment Year",
      placeholder: "Select year",
      type: "select",
      required: true,
      fieldset: "basicInfo",
      colSpan: 3,
      options: Array.from(
        { length: new Date().getFullYear() - 1900 + 1 },
        (_, i) => {
          const year = new Date().getFullYear() - i;
          return { value: year.toString(), label: year.toString() };
        },
      ),
    },
    {
      name: "societyType",
      label: "Society Type",
      placeholder: "Select society type",
      type: "select",
      required: true,
      options: [
        { value: "apartment", label: "Apartment" },
        { value: "villa", label: "Villa" },
        { value: "mixed", label: "Mixed" },
      ],
      fieldset: "basicInfo",
      colSpan: 3,
    },
    {
      name: "societyLevelId",
      label: "Society Level",
      placeholder: "Select society level",
      type: "select",
      required: true,
      options: levelOptions,
      fieldset: "basicInfo",
      colSpan: 3,
    },

    /* ── Location ── */
    {
      name: "addressLine1",
      label: "Address Line 1",
      type: "textarea",
      required: true,
      fieldset: "location",
      colSpan: 12,
      maxLength: 255,
    },
    {
      name: "areaLocality",
      label: "Area / Locality",
      placeholder: "Enter area",
      type: "text",
      required: true,
      fieldset: "location",
      colSpan: 4,
      minLength: 3,
      maxLength: 100,
    },
    {
      name: "stateCode",
      label: "State",
      placeholder: "Select state",
      type: "select",
      required: true,
      options: stateOptions,
      fieldset: "location",
      colSpan: 4,
      onChange: (value: string | null, form: FormInstance) => {
        if (value) {
          form.setFieldValue("districtCode", "");
          getDistrictMaster(Number(value));
        } else {
          setDistrictData([]);
          form.setFieldValue("districtCode", "");
        }
      },
    },
    {
      name: "districtCode",
      label: "District",
      placeholder: "Select District",
      type: "select",
      required: true,
      options: districtOptions,
      fieldset: "location",
      colSpan: 4,
    },
    {
      name: "city",
      label: "City",
      placeholder: "Enter city",
      type: "text",
      required: true,
      fieldset: "location",
      colSpan: 4,
      minLength: 2,
      maxLength: 50,
    },
    {
      name: "pincode",
      label: "Pincode",
      placeholder: "e.g. 600001",
      type: "number",
      required: true,
      fieldset: "location",
      colSpan: 4,
      maxLength: 6,
    },
    {
      name: "landmark",
      label: "Landmark",
      placeholder: "e.g. Near Metro Station",
      type: "text",
      required: false,
      fieldset: "location",
      colSpan: 4,
      maxLength: 100,
    },

    /* ── Building ── */
    {
      name: "blockName",
      label: "Block Name",
      placeholder: "e.g. A Block",
      type: "text",
      required: true,
      fieldset: "building",
      colSpan: 3,
      maxLength: 50,
    },
    {
      name: "numberOfFloors",
      label: "No. of Floors",
      placeholder: "e.g. 10",
      type: "number",
      required: true,
      fieldset: "building",
      colSpan: 3,
      maxLength: 5,
    },
    {
      name: "totalFlats",
      label: "Total Flats",
      placeholder: "e.g. 200",
      type: "number",
      required: true,
      fieldset: "building",
      colSpan: 3,
      maxLength: 5,
    },
    {
      name: "parkingSlots",
      label: "Parking Slots",
      placeholder: "e.g. 80",
      type: "number",
      fieldset: "building",
      colSpan: 2,
      maxLength: 5,
    },

    /* ── Admin Info ── */
    {
      name: "adminMobile",
      label: "Mobile Number",
      type: "text",
      fieldset: "adminInfo",
      placeholder: "Enter mobile number",
      required: true,
      maxLength: 10,
      colSpan: 10,
      lookupConfig: {
        onLookup: async (value, entryIndex) => {
          const result = await fetchUserByMobile(value);

          if (result.success && result.data) {
            // Store valid lookup data in ref — no state update so no re-render
            adminLookupData.current[entryIndex] = {
              userId: result.data.userId,
              roleId: result.data.roleId,
              roleName: result.data.role,
            };
          } else {
            // Remove any previous valid entry for this row on failure
            delete adminLookupData.current[entryIndex];
          }

          return result;
        },

        renderResult: (data) => (
          <Box
            p="10px 14px"
            style={{
              borderRadius: 10,
              border: "1px solid var(--mantine-color-teal-2)",
              background:
                "linear-gradient(135deg, var(--mantine-color-teal-0) 0%, var(--mantine-color-cyan-0) 100%)",
              boxShadow: "0 2px 8px rgba(32,178,170,0.08)",
              animation: "fadeSlideIn 0.25s ease",
            }}
          >
            <style>{`
              @keyframes fadeSlideIn {
                from { opacity: 0; transform: translateX(8px); }
                to   { opacity: 1; transform: translateX(0);   }
              }
            `}</style>
            <Flex align="center" gap={10}>
              <Flex
                align="center"
                justify="center"
                style={{
                  width: 36,
                  height: 36,
                  borderRadius: "50%",
                  background:
                    "linear-gradient(135deg, var(--mantine-color-teal-5), var(--mantine-color-cyan-4))",
                  color: "#fff",
                  fontWeight: 700,
                  fontSize: 13,
                  flexShrink: 0,
                  letterSpacing: 0.5,
                }}
              >
                {data.name
                  ?.split(" ")
                  .map((w: string) => w[0])
                  .join("")
                  .slice(0, 2)
                  .toUpperCase()}
              </Flex>
              <Box style={{ minWidth: 0 }}>
                <Text
                  size="xs"
                  fw={700}
                  c="teal.8"
                  style={{
                    lineHeight: 1.2,
                    whiteSpace: "nowrap",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                  }}
                >
                  {data.name}
                </Text>
                <Text
                  size="10px"
                  c="dimmed"
                  mt={2}
                  style={{
                    whiteSpace: "nowrap",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                  }}
                >
                  {data.email}
                </Text>
              </Box>
            </Flex>
          </Box>
        ),

        renderError: (error) => (
          <Box
            p="8px 12px"
            style={{
              borderRadius: 10,
              border: "1px solid var(--mantine-color-red-2)",
              background:
                "linear-gradient(135deg, var(--mantine-color-red-0), var(--mantine-color-pink-0))",
              boxShadow: "0 2px 8px rgba(220,53,69,0.07)",
              animation: "fadeSlideIn 0.25s ease",
            }}
          >
            <Flex align="center" gap={8}>
              <Text size="18px" style={{ lineHeight: 1 }}>
                ⚠️
              </Text>
              <Text size="xs" fw={500} c="red.7">
                {error}
              </Text>
            </Flex>
          </Box>
        ),
      },
    },

    /* ── Status ── */
    {
      name: "packageId",
      label: "Package Name",
      placeholder: "Select package",
      type: "select",
      required: true,
      options: packageOptions,
      fieldset: "status",
      colSpan: 6,
    },
    {
      name: "status",
      label: "Society Status",
      placeholder: "Select society status",
      type: "select",
      required: true,
      options: STATUS_OPTIONS.map((o) => ({ label: o.label, value: o.value })),
      fieldset: "status",
      colSpan: 6,
    },
  ];

  // ── Render ────────────────────────────────────────────────────────────────

  const columns: Column<SocietyItem>[] = [
    {
      header: "Sl No",
      align: "center",
      width: "7%",
      render: (_: unknown, _row: SocietyItem, index: number) => (
        <Text size="sm">
          {(currentPage - 1) * RECORDS_PER_PAGE + index + 1}
        </Text>
      ),
    },
    {
      header: "Actions",
      align: "center",
      width: "10%",
      render: (_value: unknown, row: SocietyItem) => (
        <>
          <Tooltip label="Edit Society">
            <ActionIcon
              color="blue"
              variant="light"
              radius="md"
              onClick={async () => {
                setEditMode(true);
                setLoading(true);
                const data = await fetchSocietyById(row.societyId);
                if (data) {
                  if (data.stateCode)
                    await getDistrictMaster(Number(data?.stateCode));

                  // Pre-populate ref so submit works without re-searching
                  adminLookupData.current = {};
                  const seededResults: Record<string, LookupResult> = {};
                  data.adminDetails?.forEach(
                    (admin: AdminDetailFromApi, index: number) => {
                      adminLookupData.current[index] = {
                        userId: admin.userId,
                        roleId: admin.roleId || "",
                        roleName: admin.roleName,
                      };
                      // Seed result card so name/email show without re-typing
                      seededResults[`adminInfo.${index}.adminMobile`] = {
                        success: true,
                        data: { name: admin.name, email: admin.email },
                      };
                    },
                  );
                  setInitialLookupResults(seededResults);

                  setSelectedSociety(data);
                  setDrawerOpened(true);
                }
                setLoading(false);
              }}
            >
              <IconEdit size={16} />
            </ActionIcon>
          </Tooltip>
          <Tooltip label="Delete Society">
            <ActionIcon
              color="red"
              variant="light"
              radius="md"
              onClick={() => handleDeleteClick(row)}
            >
              <IconTrash size={16} />
            </ActionIcon>
          </Tooltip>
        </>
      ),
    },
    { header: "Society Name", accessor: "societyName", align: "left" },
    { header: "Society Code", accessor: "societyCode", align: "left" },
    { header: "Level", accessor: "societyLevel", align: "left" },
    {
      header: "Status",
      width: "10%",
      align: "center",
      accessor: "status",
      render: (value) => {
        const status =
          STATUS_CONFIG[value as unknown as keyof typeof STATUS_CONFIG];
        if (!status) return null;
        return (
          <Badge size="sm" radius="xs" variant="filled" color={status.color}>
            {status.label}
          </Badge>
        );
      },
    },
  ];

  return (
    <Stack gap="md">
      <AppBreadcrumbs
        items={[
          { label: "Society Management", path: RouteConfig.SOCIETY_MGT },
          { label: "New society" },
        ]}
      />

      <Group justify="space-between">
        <Affix position={{ bottom: 40, right: 20 }}>
          <Button
            leftSection={<IconPlus size={20} />}
            radius="xl"
            size="md"
            color="primary.5"
            style={{
              position: "fixed",
              bottom: 32,
              right: 32,
              zIndex: 100,
              boxShadow: "0 4px 20px rgba(0, 0, 0, 0.15)",
            }}
            onClick={() => {
              setEditMode(false);
              setSelectedSociety(null);
              setDistrictData([]);
              adminLookupData.current = {};
              setInitialLookupResults({});
              setDrawerOpened(true);
            }}
          >
            Create society
          </Button>
        </Affix>
      </Group>

      <Group gap="sm">
        <TextInput
          placeholder="Search by name or code"
          leftSection={<IconSearch size={16} />}
          value={searchName}
          onChange={(e) => {
            setSearchName(e.currentTarget.value);
            setCurrentPage(1);
          }}
        />
        <Select
          placeholder="Status"
          data={STATUS_OPTIONS}
          clearable
          value={filters.status}
          onChange={(value) =>
            setFilters((prev) => ({ ...prev, status: value }))
          }
        />
        <Select
          placeholder="Society Level"
          data={levelOptions}
          clearable
          value={filters.societyLevel}
          onChange={(value) =>
            setFilters((prev) => ({ ...prev, societyLevel: value }))
          }
        />
      </Group>

      <Box>
        <DataTable
          data={societyData}
          loading={loading}
          columns={columns}
          pageSize={RECORDS_PER_PAGE}
          currentPage={currentPage}
          onPageChange={setCurrentPage}
          totalRecords={totalRecords}
        />
      </Box>

      <DrawerForm
        key={selectedSociety?.societyId || "new"}
        position="right"
        opened={drawerOpened}
        onClose={() => {
          adminLookupData.current = {};
          setInitialLookupResults({});
          setDrawerOpened(false);
        }}
        title={editMode ? "Edit Society" : "Add Society"}
        fields={formFields}
        fieldsets={fieldsetConfigs}
        initialLookupResults={initialLookupResults}
        onRemoveEntry={(fieldsetId, index) => {
          if (fieldsetId === "adminInfo") {
            // Remove this entry and re-index the remaining ones
            delete adminLookupData.current[index];
            const reindexed: Record<number, AdminLookupEntry> = {};
            Object.entries(adminLookupData.current).forEach(([k, v]) => {
              const ki = Number(k);
              reindexed[ki > index ? ki - 1 : ki] = v;
            });
            adminLookupData.current = reindexed;
          }
        }}
        initialValues={
          editMode && selectedSociety
            ? mapSocietyToForm(selectedSociety)
            : {
                blocks: [
                  {
                    blockName: "",
                    numberOfFloors: "",
                    totalFlats: "",
                    parkingSlots: "",
                  },
                ],
              }
        }
        onSubmit={async (values) => {
          const payload = transformToPayload(
            values as SocietyFormValues,
            editMode,
          );
          try {
            if (editMode && selectedSociety?.societyId) {
              await updateSociety(selectedSociety.societyId, payload);
            } else {
              await createSociety(payload);
            }
            adminLookupData.current = {}; // reset on successful submit
            setDrawerOpened(false);
            fetchSocietyDetails();
          } catch (err) {
            console.error(err);
          }
        }}
        size="xl"
      />

      <CustomModal
        opened={deleteModalOpen}
        onClose={() => setDeleteModalOpen(false)}
        icon={IMAGES.QUESTION}
        title="Confirm Deletion"
        subtext="Are you sure you want to delete this user?"
        actionText="Yes, Delete"
        onAction={handleConfirmDelete}
        showCancel
        cancelText="No"
      />
    </Stack>
  );
};

export default NewSociety;
