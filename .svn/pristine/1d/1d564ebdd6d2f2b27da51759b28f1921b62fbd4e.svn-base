"use client";

import { useState } from "react";
import {
  Affix,
  Avatar,
  Badge,
  Box,
  Button,
  Divider,
  Drawer,
  Group,
  Modal,
  Popover,
  Select,
  SimpleGrid,
  Stack,
  Text,
  TextInput,
  Tooltip,
} from "@mantine/core";
import {
  IconCar,
  IconDeviceFloppy,
  IconEdit,
  IconMotorbike,
  IconPhoto,
  IconPlus,
  IconTrash,
  IconUpload,
  IconX,
} from "@tabler/icons-react";
import { CORAL, CORAL_LIGHT, PEACH, softCard } from "@/utils/constants";
import { SocietyAdminTable } from "@/components/SocietyAdminTable";
import { SocietyAdminTableColumn } from "../SocietyAdminTable/SocietyAdmin.types";
import {
  ResidentOption,
  ResidentVehicleFormValues,
  ResidentVehicleRecord,
  STATIC_RESIDENT_OPTIONS,
  STATIC_RESIDENT_VEHICLES,
  VehicleEntry,
  VehicleEntryForm,
  VehicleStatus,
} from "./VehicleRegistration.types";

// ─── Design tokens ────────────────────────────────────────────────────────────

const gradientBg = `linear-gradient(135deg, ${CORAL} 0%, ${CORAL_LIGHT} 100%)`;

const VEH_TYPES = [
  { value: "", label: "All Types" },
  { value: "4-wheeler", label: "4-Wheeler" },
  { value: "2-wheeler", label: "2-Wheeler" },
];
const STATUS_OPTIONS = [
  { value: "", label: "All Status" },
  { value: "active", label: "Active" },
  { value: "inactive", label: "Inactive" },
];

const inputStyle = {
  input: { borderColor: "#FFE5E5", borderRadius: 12, fontWeight: 600 },
  label: {
    fontWeight: 700,
    fontSize: 11,
    color: "#888",
    textTransform: "uppercase" as const,
    letterSpacing: "0.05em",
  },
};

const emptyVehicle = (): VehicleEntryForm => ({
  vehicleNumber: "",
  vehicleModel: "",
  vehicleType: "",
  status: "active",
});

// ─── Props ────────────────────────────────────────────────────────────────────

interface VehicleRegistrationProps {
  records?: ResidentVehicleRecord[];
  residentOptions?: ResidentOption[];
  onAdd?: (values: ResidentVehicleFormValues) => void;
  onEdit?: (values: ResidentVehicleFormValues) => void;
}

// ─── Main component ───────────────────────────────────────────────────────────

export function VehicleRegistration({
  records = STATIC_RESIDENT_VEHICLES,
  residentOptions = STATIC_RESIDENT_OPTIONS,
  onAdd,
  onEdit,
}: VehicleRegistrationProps) {
  const [typeFilter, setTypeFilter] = useState("");
  const [statusFilter, setStatusFilter] = useState("");
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [editing, setEditing] = useState<ResidentVehicleRecord | null>(null);

  // Flatten for stats
  const allVehicles = records.flatMap((r) => r.vehicles);

  // Filter records — keep record if any vehicle matches filters
  const filtered = records.filter((rec) => {
    if (!typeFilter && !statusFilter) return true;
    return rec.vehicles.some((v) => {
      if (typeFilter && v.vehicleType !== typeFilter) return false;
      if (statusFilter && v.status !== statusFilter) return false;
      return true;
    });
  });

  const openAdd = () => {
    setEditing(null);
    setDrawerOpen(true);
  };
  const openEdit = (r: ResidentVehicleRecord) => {
    setEditing(r);
    setDrawerOpen(true);
  };

  // ── Table columns ──────────────────────────────────────────────────────────
  const columns: SocietyAdminTableColumn<ResidentVehicleRecord>[] = [
    {
      key: "residentName",
      label: "Resident",
      searchable: true,
      render: (row) => (
        <Group gap="sm" wrap="nowrap">
          <Avatar
            size={34}
            radius="xl"
            style={{
              background: "lightgray",
              fontSize: 13,
              fontWeight: 900,
              color: "#fff",
              flexShrink: 0,
            }}
          >
            {row.residentName.charAt(0)}
          </Avatar>
          <Text fz="sm" fw={700} c="#1a1a1a">
            {row.residentName}
          </Text>
        </Group>
      ),
    },
    {
      key: "vehicles",
      label: "Vehicles",
      render: (row) => <VehiclePills vehicles={row.vehicles} />,
    },
    {
      key: "vehicleCount",
      label: "Count",
      render: (row) => (
        <Badge size="sm" variant="light" color="red" fw={700} radius="xl">
          {row.vehicles.length} vehicle{row.vehicles.length > 1 ? "s" : ""}
        </Badge>
      ),
    },
    {
      key: "registeredDate",
      label: "Registered",
      render: (row) => (
        <Text fz="xs" c="dimmed" fw={600}>
          {row.registeredDate}
        </Text>
      ),
    },
    {
      key: "actions",
      label: "",
      render: (row) => (
        <Tooltip label="Edit">
          <Button
            size="xs"
            radius="xl"
            variant="subtle"
            color="gray"
            onClick={() => openEdit(row)}
          >
            <IconEdit size={14} />
          </Button>
        </Tooltip>
      ),
    },
  ];

  // ── Filter slot ────────────────────────────────────────────────────────────
  const filterSlot = (
    <>
      <Select
        data={VEH_TYPES}
        value={typeFilter}
        onChange={(v) => setTypeFilter(v ?? "")}
        w={120}
        styles={{ input: { borderColor: "#FFE5E5", fontWeight: 600 } }}
      />
      <Select
        data={STATUS_OPTIONS}
        value={statusFilter}
        onChange={(v) => setStatusFilter(v ?? "")}
        w={120}
        styles={{ input: { borderColor: "#FFE5E5", fontWeight: 600 } }}
      />
    </>
  );

  return (
    <>
      {/* ── Stats row ──────────────────────────────────────────────────── */}
      <SimpleGrid cols={{ base: 2, sm: 4 }} mb="lg" spacing="sm">
        {[
          { label: "Residents", value: records.length, gradient: false },
          {
            label: "Total Vehicles",
            value: allVehicles.length,
            gradient: true,
          },
          {
            label: "4-Wheelers",
            value: allVehicles.filter((v) => v.vehicleType === "4-wheeler")
              .length,
            gradient: false,
          },
          {
            label: "2-Wheelers",
            value: allVehicles.filter((v) => v.vehicleType === "2-wheeler")
              .length,
            gradient: false,
          },
        ].map((s) => (
          <Box
            key={s.label}
            style={{
              ...softCard,
              borderRadius: 16,
              padding: "14px 16px",
              background: s.gradient ? gradientBg : "#fff",
              border: s.gradient ? "none" : "1.5px solid #FFE5E5",
              boxShadow: s.gradient ? `0 4px 14px ${CORAL}44` : undefined,
            }}
          >
            <Text
              fz="xs"
              fw={700}
              tt="uppercase"
              style={{
                color: s.gradient ? "rgba(255,255,255,0.8)" : "#999",
                letterSpacing: "0.06em",
              }}
            >
              {s.label}
            </Text>
            <Text
              fz={26}
              fw={900}
              lh={1}
              style={{ color: s.gradient ? "#fff" : CORAL }}
            >
              {s.value}
            </Text>
          </Box>
        ))}
      </SimpleGrid>

      {/* ── Add button + table ──────────────────────────────────────────── */}
      <Group justify="flex-end" mb="md">
        <Affix position={{ bottom: 40, right: 20 }}>
          <Button
            onClick={openAdd}
            radius="xl"
            leftSection={<IconPlus size={15} stroke={2.5} />}
            style={{
              background: gradientBg,
              border: "none",
              fontWeight: 800,
              boxShadow: `0 4px 14px ${CORAL}55`,
            }}
          >
            Register Vehicle
          </Button>
        </Affix>
      </Group>

      <SocietyAdminTable
        data={filtered as any}
        columns={columns as any}
        rowKey="recordId"
        searchPlaceholder="Search by resident name…"
        filterSlot={filterSlot}
        emptyMessage="No records match the selected filters."
      />

      {/* ── Add / Edit drawer ───────────────────────────────────────────── */}
      <Drawer
        opened={drawerOpen}
        onClose={() => setDrawerOpen(false)}
        position="right"
        size="lg"
        padding="xl"
        title={
          <Group gap="sm">
            <Box
              style={{
                width: 32,
                height: 32,
                borderRadius: 8,
                background: gradientBg,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <IconCar size={16} color="#fff" />
            </Box>
            <Box>
              <Text fw={900} fz="sm" c="#1a1a1a">
                {editing ? "Edit Vehicles" : "Register Vehicles"}
              </Text>
              <Text fz="xs" c="dimmed">
                {editing
                  ? `Editing ${editing.residentName}'s vehicles`
                  : "Select resident & add vehicles"}
              </Text>
            </Box>
          </Group>
        }
        styles={{
          header: { background: PEACH, borderBottom: "1.5px solid #FFE5E5" },
          body: { background: PEACH },
        }}
      >
        <ResidentVehicleForm
          initial={editing ?? undefined}
          residentOptions={residentOptions}
          onSubmit={(vals) => {
            editing ? onEdit?.(vals) : onAdd?.(vals);
            setDrawerOpen(false);
          }}
          onCancel={() => setDrawerOpen(false)}
        />
      </Drawer>
    </>
  );
}

// ─── Vehicle pills — shown in table cell ─────────────────────────────────────

function VehiclePills({ vehicles }: { vehicles: VehicleEntry[] }) {
  const [opened, setOpened] = useState<string | null>(null);

  return (
    <Group gap={6} wrap="wrap">
      {vehicles.map((v) => (
        <Popover
          key={v.vehicleId}
          opened={opened === v.vehicleId}
          onChange={(isOpen) => {
            // This handles both opening and closing (including outside clicks)
            if (!isOpen) {
              setOpened(null);
            }
          }}
          position="bottom-start"
          withArrow
          shadow="md"
          radius="lg"
          closeOnClickOutside={true}
          clickOutsideEvents={["mousedown", "touchstart"]}
        >
          <Popover.Target>
            <Box
              onClick={(e) => {
                e.stopPropagation();
                setOpened(opened === v.vehicleId ? null : v.vehicleId);
              }}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 5,
                padding: "3px 10px",
                borderRadius: 999,
                cursor: "pointer",
                background: v.status === "active" ? PEACH : "#f5f5f5",
                border: `1.5px solid ${v.status === "active" ? "#FFCCCC" : "#e0e0e0"}`,
                transition: "all 0.15s",
              }}
            >
              {v.vehicleType === "4-wheeler" ? (
                <IconCar
                  size={11}
                  color={v.status === "active" ? CORAL : "#aaa"}
                />
              ) : (
                <IconMotorbike
                  size={11}
                  color={v.status === "active" ? CORAL : "#aaa"}
                />
              )}
              <Text
                fz="10px"
                fw={800}
                style={{
                  color: v.status === "active" ? CORAL : "#aaa",
                  letterSpacing: "0.03em",
                }}
              >
                {v.vehicleNumber}
              </Text>
            </Box>
          </Popover.Target>

          <Popover.Dropdown
            style={{
              background: "#fff",
              border: "1.5px solid #FFE5E5",
              padding: 14,
              minWidth: 200,
            }}
          >
            <Stack gap={8}>
              <Group gap="sm">
                <Box
                  style={{
                    width: 36,
                    height: 36,
                    borderRadius: 10,
                    background: v.status === "active" ? gradientBg : "#eee",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                  }}
                >
                  {v.vehicleType === "4-wheeler" ? (
                    <IconCar
                      size={18}
                      color={v.status === "active" ? "#fff" : "#aaa"}
                    />
                  ) : (
                    <IconMotorbike
                      size={18}
                      color={v.status === "active" ? "#fff" : "#aaa"}
                    />
                  )}
                </Box>
                <Box>
                  <Text fz="sm" fw={800} c="#1a1a1a">
                    {v.vehicleNumber}
                  </Text>
                  <Text fz="xs" c="dimmed">
                    {v.vehicleModel}
                  </Text>
                </Box>
              </Group>
              <Group gap="xs">
                <Badge
                  size="xs"
                  variant="light"
                  color={v.vehicleType === "4-wheeler" ? "blue" : "teal"}
                  fw={700}
                >
                  {v.vehicleType}
                </Badge>
                <Badge
                  size="xs"
                  variant="light"
                  color={v.status === "active" ? "teal" : "gray"}
                  fw={700}
                >
                  {v.status}
                </Badge>
              </Group>
            </Stack>
          </Popover.Dropdown>
        </Popover>
      ))}
    </Group>
  );
}

// ─── Resident + multi-vehicle form ───────────────────────────────────────────

function ResidentVehicleForm({
  initial,
  residentOptions,
  onSubmit,
  onCancel,
}: {
  initial?: ResidentVehicleRecord;
  residentOptions: ResidentOption[];
  onSubmit: (v: ResidentVehicleFormValues) => void;
  onCancel: () => void;
}) {
  const [residentId, setResidentId] = useState(initial?.residentId ?? "");
  const [residentName, setResidentName] = useState(initial?.residentName ?? "");
  const [vehicles, setVehicles] = useState<VehicleEntryForm[]>(
    initial?.vehicles.map((v) => ({
      vehicleId: v.vehicleId,
      vehicleNumber: v.vehicleNumber,
      vehicleModel: v.vehicleModel,
      vehicleType: v.vehicleType,
      status: v.status,
    })) ?? [emptyVehicle()],
  );

  const handleResidentChange = (val: string | null) => {
    const opt = residentOptions.find((r) => r.value === val);
    setResidentId(val ?? "");
    setResidentName(opt?.label ?? "");
  };

  const updateVehicle = (
    index: number,
    key: keyof VehicleEntryForm,
    val: string,
  ) => {
    setVehicles((prev) =>
      prev.map((v, i) => (i === index ? { ...v, [key]: val } : v)),
    );
  };

  const addVehicle = () => setVehicles((prev) => [...prev, emptyVehicle()]);

  const removeVehicle = (index: number) =>
    setVehicles((prev) => prev.filter((_, i) => i !== index));

  const handleImageChange = (
    index: number,
    e: React.ChangeEvent<HTMLInputElement>,
  ) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    setVehicles((prev) =>
      prev.map((v, i) => (i === index ? { ...v, vehicleImageUrl: url } : v)),
    );
  };

  return (
    <Stack gap="md" mt="xs">
      {/* Resident selector */}
      <Select
        label="Resident"
        placeholder="Search and select resident…"
        data={residentOptions}
        value={residentId || null}
        onChange={handleResidentChange}
        searchable
        styles={inputStyle}
      />

      <Divider
        label={
          <Text
            fz="10px"
            fw={800}
            tt="uppercase"
            style={{ color: CORAL, letterSpacing: "0.08em" }}
          >
            Vehicles
          </Text>
        }
        labelPosition="left"
        color="#FFE5E5"
      />

      {/* Vehicle entries */}
      <Stack gap="md">
        {vehicles.map((v, index) => (
          <Box
            key={index}
            style={{
              ...softCard,
              borderRadius: 16,
              padding: 16,
              position: "relative",
            }}
          >
            {/* Remove button — only if more than 1 vehicle */}
            {vehicles.length > 1 && (
              <Box
                onClick={() => removeVehicle(index)}
                style={{
                  position: "absolute",
                  top: 10,
                  right: 10,
                  width: 22,
                  height: 22,
                  borderRadius: "50%",
                  background: "#fee",
                  border: "1px solid #FFCCCC",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                }}
              >
                <IconX size={11} color={CORAL} />
              </Box>
            )}

            <Text
              fz="10px"
              fw={800}
              c="dimmed"
              tt="uppercase"
              mb="sm"
              style={{ letterSpacing: "0.07em" }}
            >
              Vehicle {index + 1}
            </Text>

            <Stack gap="sm">
              <SimpleGrid cols={2} spacing="sm">
                <TextInput
                  label="Vehicle Number"
                  placeholder="OD05AB1234"
                  leftSection={<IconCar size={13} color={CORAL} />}
                  value={v.vehicleNumber}
                  onChange={(e) =>
                    updateVehicle(index, "vehicleNumber", e.target.value)
                  }
                  styles={inputStyle}
                  radius="md"
                />

                <TextInput
                  label="Vehicle Model"
                  placeholder="Maruti Swift"
                  leftSection={<IconCar size={13} color={CORAL} />}
                  value={v.vehicleModel}
                  onChange={(e) =>
                    updateVehicle(index, "vehicleModel", e.target.value)
                  }
                  styles={inputStyle}
                  radius="md"
                />
              </SimpleGrid>

              <SimpleGrid cols={2} spacing="sm">
                <Select
                  label="Type"
                  data={[
                    { value: "4-wheeler", label: "4-Wheeler" },
                    { value: "2-wheeler", label: "2-Wheeler" },
                  ]}
                  value={v.vehicleType || null}
                  onChange={(val) =>
                    updateVehicle(index, "vehicleType", val ?? "")
                  }
                  styles={inputStyle}
                />

                <Select
                  label="Status"
                  data={[
                    { value: "active", label: "Active" },
                    { value: "inactive", label: "Inactive" },
                  ]}
                  value={v.status}
                  onChange={(val) =>
                    updateVehicle(index, "status", val ?? "active")
                  }
                  styles={inputStyle}
                />
              </SimpleGrid>

              {/* Vehicle image upload */}
              <Box>
                <Text
                  fz="10px"
                  fw={700}
                  c="#888"
                  tt="uppercase"
                  mb={6}
                  style={{ letterSpacing: "0.05em" }}
                >
                  Vehicle Photo (optional)
                </Text>
                <Box
                  component="label"
                  htmlFor={`vehicleImg-${index}`}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: 10,
                    padding: "10px 14px",
                    borderRadius: 12,
                    border: `2px dashed #FFCCCC`,
                    background: PEACH,
                    cursor: "pointer",
                  }}
                >
                  {v.vehicleImageUrl ? (
                    <img
                      src={v.vehicleImageUrl}
                      alt="vehicle"
                      style={{
                        width: 40,
                        height: 40,
                        borderRadius: 8,
                        objectFit: "cover",
                      }}
                    />
                  ) : (
                    <Box
                      style={{
                        width: 36,
                        height: 36,
                        borderRadius: 8,
                        background: "#fff",
                        border: "1.5px solid #FFCCCC",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                      }}
                    >
                      <IconPhoto size={16} color={CORAL} />
                    </Box>
                  )}
                  <Box>
                    <Text fz="xs" fw={700} style={{ color: CORAL }}>
                      {v.vehicleImageUrl
                        ? "Change photo"
                        : "Upload vehicle photo"}
                    </Text>
                    <Text fz="10px" c="dimmed">
                      JPG, PNG up to 5MB
                    </Text>
                  </Box>
                  <input
                    id={`vehicleImg-${index}`}
                    type="file"
                    accept="image/*"
                    style={{ display: "none" }}
                    onChange={(e) => handleImageChange(index, e)}
                  />
                </Box>
              </Box>
            </Stack>
          </Box>
        ))}
      </Stack>

      {/* Add vehicle button */}
      <Button
        variant="subtle"
        radius="xl"
        size="sm"
        leftSection={<IconPlus size={14} />}
        onClick={addVehicle}
        style={{ color: CORAL, fontWeight: 700, alignSelf: "flex-start" }}
      >
        Add another vehicle
      </Button>

      {/* Submit / Cancel */}
      <Group justify="flex-end" gap="sm" mt="xs">
        <Button variant="subtle" color="gray" radius="xl" onClick={onCancel}>
          Cancel
        </Button>

        <Button
          radius="xl"
          leftSection={<IconDeviceFloppy size={15} />}
          style={{
            background: gradientBg,
            border: "none",
            fontWeight: 800,
            boxShadow: `0 4px 14px ${CORAL}55`,
          }}
          onClick={() =>
            onSubmit({
              recordId: initial?.recordId,
              residentId,
              residentName,
              vehicles,
            })
          }
        >
          {initial ? "Save Changes" : "Register Vehicles"}
        </Button>
      </Group>
    </Stack>
  );
}
