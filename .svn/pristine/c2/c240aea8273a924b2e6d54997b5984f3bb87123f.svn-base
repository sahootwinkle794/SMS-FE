@import "./fonts/fonts.css";

.header,
.hero,
.feature,
.service,
.high,
.faqs,
.contacts {
    width: 100%;
}

/* scroll to top button start  */
.scroll-btn {
  background: linear-gradient(120deg, #FF7853, #FC2631, #FFB3C1);
  background-size: 300% 300%;
  color: white;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.scroll-btn:hover {
  animation: gradientFlow 2s linear infinite;
  transform: translateY(-5px) scale(1.05);
  box-shadow: 0 18px 35px rgba(252, 38, 49, 0.6);
}

@keyframes gradientFlow {
  0% {
    background-position: 0% 50%;
  }
  100% {
    background-position: 100% 50%;
  }
}
/* Smooth shine effect */
.scroll-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    120deg,
    transparent,
    rgba(255,255,255,0.6),
    transparent
  );
}

.scroll-btn:hover::before {
  animation: shine 0.8s ease;
}

@keyframes shine {
  100% {
    left: 120%;
  }
}

/* Arrow movement */
.arrow-icon {
  transition: transform 0.3s ease;
}

.scroll-btn:hover .arrow-icon {
  transform: translateY(-4px);
}

/* scroll to top button end  */

/* header section start  */
.header {
    position: absolute !important;
    top: 0;
    background: transparent !important;
}

.btn-text {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
}

.btn-text-head {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
}

.btn-text-head img {
    transition: all 0.3s ease;
}

/* button hover */
.btn-text-head:hover {
    box-shadow: 0 6px 18px rgba(255, 44, 54, 0.4);
}

/* animate image */
.btn-text-head:hover img {
    transform: translateX(5px) rotate(0deg);
}

/* header section end  */
/* hero section start  */
.hero-spacing {
  transition: letter-spacing 0.4s ease;
}

.hero-spacing:hover {
  letter-spacing: 3px;
}

.pulse-mobile {
  animation: pulseMobile 4s ease-in-out infinite;
}

@keyframes pulseMobile {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
  100% {
    transform: scale(1);
  }
}
.scroll-animate {
  opacity: 0;
  transform: translateY(40px);
  transition: all 0.8s ease;
}

.scroll-animate.active {
  opacity: 1;
  transform: translateY(0);
}
.scroll-animate {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease;
}

.scroll-animate.show {
    opacity: 1;
    transform: translateY(0);
}

.scroll-animate.active {
    opacity: 1;
    transform: translateY(0);
}

.hero {
    position: relative;
    /* min-height: 100vh; */
    background-image: url('../assets/img/hero.svg');
    background-position: top center;
    background-size: cover;
    background-repeat: no-repeat;
}
  
.hero-text {
    font-family: "Geist", sans-serif;
    font-weight: 300;
}

.hero-btn {
    font-family: "Raleway", sans-serif;
    font-weight: 600;
    padding: 10px 60px;
}

.hero-btn {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    transition: all 0.3s ease;
}

/* hover lift */
.hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(252, 38, 49, 0.35);
}

.hero-btn::before {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 120%;
    height: 100%;
    background: rgba(255, 255, 255, 0.25);
    transform: skewX(-25deg);
    transition: left 0.5s ease;
}

.hero-btn:hover::before {
    left: 120%;
}

/* hero section end  */
/* features section start  */
 
.feature-title {
    transition-delay: 0.1s;
}

.feature-title2 {
    transition-delay: 0.2s;
}

.feature-title3 {
    transition-delay: 0.3s;
}

.feature-title4 {
    transition-delay: 0.4s;
}

.featureCard {
    transition: box-shadow 0.3s ease;
}

.featureCard:hover {
    box-shadow: 0 10px 30px rgba(255, 44, 54, 0.25);
}

.feature-icon {
    transition: transform 0.35s ease;
}

.featureCard:hover .feature-icon {
    transform: rotate(10deg) scale(1.15);
}

.feature {
    border-top-left-radius: 66.67px;
    border-top-right-radius: 66.67px;
    margin-bottom: 22px;

}

.feature-icon {
    width: 53px;
    height: auto;
}

.feature-con {
    padding-bottom: 80px;
}

.feature-title {
    color: #C33923;
    letter-spacing: 20%;
    font-size: 20px;
    font-family: "Outfit", sans-serif;
}

.feature-title2 {
    font-size: 40px;
    color: #FF2C36;
    font-family: "Geist", sans-serif;
}

.feature-title3 {
    color: black;
    font-size: 16px;
    font-family: "Outfit", sans-serif;
    font-weight: 600;

}

.feature-title4 {
    color: #000;
    font-size: 16px;
    margin-top: 10px;
    font-family: "Outfit", sans-serif;

}

.featureCard {
    background-image: url('../assets/img/card-bg.svg');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    border: none;
    /* background: linear-gradient(135deg, #FFEBE3 0%, #FFD6CA 100%); */
    transition: background 0.4s ease, box-shadow 0.3s ease;
    border-radius: 12px;
    color: #FF3952;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.featureCard:hover {
    background: linear-gradient(135deg, #FFD6CA 0%, #FFEBE3 100%);
    box-shadow: 0 10px 25px rgba(250, 153, 158, 0.171);
}

.Feature-card-text {
    font-size: 25px;
    line-height: 30px;
    font-family: "Geist", sans-serif;

}

.feature-p {
    font-size: 15px;
    margin-top: 20px;
    margin-bottom: 10px;
    color: #000 !important;
    font-family: "Outfit", sans-serif;

}

.control-btn {
    border: 1px solid #F24E1E;
    color: #F24E1E;
    width: 70px;
    height: 70px;
}

.control-btn:hover {
    background-color: #FF3952;
    color: white;
}

.control-btn:hover .arrow-icon {
    filter: brightness(0) invert(1);
}

/* features section end  */
/* services section start  */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* Stagger delays */
.delay-1 {
    transition-delay: 0.1s;
}

.delay-2 {
    transition-delay: 0.3s;
}

.delay-3 {
    transition-delay: 0.5s;
}

.delay-4 {
    transition-delay: 0.7s;
}

.delay-5 {
    transition-delay: 0.9s;
}

.service {
    background-image: url('../assets/img/serve-bg.svg');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

.serve-head {
    font-family: "Geist", sans-serif;
    /* text-align: center; */
}

.serve-title1 {
    margin-top: 55px;
    font-size: 50px;
    font-family: "Geist", sans-serif;
    color: #FF3952;
    text-align: center;
}

.serve-title2 {
    font-size: 20px;
    font-family: "Outfit", sans-serif;
    font-weight: 500;
    text-align: center;

}

.dashboard-img {
    width: 100%;
    height: auto;
}

.who-icon {
    width: 80px;
    height: 80px;
}

.who-title {
    font-weight: 600;
    font-size: 20px;
    color: white;
    font-family: "Outfit", sans-serif;

}

.who-p {
    font-size: 15px;
    color: white;
    font-family: "Outfit", sans-serif;
    font-weight: 200;
}

.who-btn {
    font-family: "Raleway", sans-serif;
    font-weight: 400;
}

/* .serve-stack{
    margin-top: 30px;
    margin-bottom: 30px;
} */
/* services section end  */
/* Contact section start  */
.btn-text img {
    transition: transform 0.3s ease;
}

.btn-text:hover img {
    transform: rotate(24deg);
}

.btn-text {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

/* Gradient animation */
.btn-text:hover {
    background: linear-gradient(135deg, #FF2C36, #FF7853);
    box-shadow: 0 6px 18px rgba(255, 44, 54, 0.4);
}

.contact-title {
    font-family: "Geist", sans-serif;
    font-size: 50px;
    font-weight: 100;
}

.contact-title2 {
    font-family: "Geist", sans-serif;
    font-size: 50px;
    font-weight: 600;
}

.contacts {
    margin-top: 50px;
}

.contact-title3 {
    font-family: "Outfit", sans-serif;
    font-size: 25px;
    font-weight: 300;
}

.highlight {
    color: #0074BD;
    font-size: 25px;
    margin-left: 10px;
}

/* Apply to all input labels */
.form-Text.mantine-InputWrapper-label {
    font-family: "Exo 2", sans-serif;
    font-weight: 400;
}

.contacts {
    padding-top: 80px;
    padding-bottom: 80px;
}

/* contact section end  */
/* faq section start  */
.faq-head {
    font-family: "Geist", sans-serif;
    font-weight: 700;
}

.faq-Qsn {
    font-family: "Geist", sans-serif;
    font-weight: 400;
}

.faq-Ans {
    font-family: "Geist", sans-serif;
    font-weight: 400;
}

/* faq section end  */
/* footer section start  */
.copy-text {
    display: flex;
    justify-content: flex-start;
    font-family: "Raleway", sans-serif;
    font-weight: 200;
}

.footer-logo {
    width: 100px;
    height: auto;
}

.footer-link {
    font-family: "Geist", sans-serif;
    font-weight: 200;
    font-size: 18px;
}
.footer-link:hover{
    color: #ffbe0a !important;
}
.footer {
    background-image: url("../assets/img/footer-bg.svg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.footer-text {
    font-family: "Geist", sans-serif;
    font-weight: 700;
    font-size: 23px;
}

.footer-text2 {
    font-family: "Geist", sans-serif;
    font-weight: 200;
    line-height: 25px;
    font-size: 15px;
    font-size: 18px;
    /* position: relative;
    padding-left: 12px; */
}

/* .footer-text2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    background: black;
    border-radius: 50%;
} */

.playstore {
    background: linear-gradient(135deg, #B73A3E 0%, #9F312F 100%);
}

.app-download {
    color: white;
    font-family: "Geist", sans-serif;
    font-size: 20px;
    font-weight: 100;
    text-align: center;
}

/* footer section end  */

/* Mobile responsive start  */
@media (min-width: 300px) and (max-width: 700px) {
    .hero-text {
        margin-top: 60px;
    }

    .hero {
        background-position: left;
    }

    .mobile-ui {
        display: none;
    }

    .mobile-ui img {
        max-width: 100%;
    }

    .service {
        background-image: url("../assets/img/footer-bg.svg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: white;
    }

    .serve-title1 {
        color: white;
    }

    .social-ft {
        display: flex;
        justify-content: center;
    }

    .faq-img {
        display: none;
    }
}

/* Mobile responsive end  */
/* Tablet responsive start  */
@media (min-width: 701px) and (max-width: 990px) {
    .faq-img {
        display: none;
    }
}

@media (min-width: 701px) and (max-width: 1000px) {
    .hero-text {
        margin-top: 60px;
    }

    .hero {
        background-position: left;
    }

    .mobile-ui {
        display: none;
    }

    .mobile-ui img {
        max-width: 100%;
    }

    .service {
        background-image: url("../assets/img/footer-bg.svg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: rgb(252, 252, 252);
    }

    .serve-title1 {
        color: rgb(255, 255, 255);
    }

    .social-ft {
        display: flex;
        justify-content: center;
    }
}

/* Tablet responsive end  */

