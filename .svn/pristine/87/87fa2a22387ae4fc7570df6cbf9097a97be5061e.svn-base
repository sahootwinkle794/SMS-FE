"use client";
import React, { useCallback, useEffect, useState } from "react";
import { AppBreadcrumbs, CustomModal, PackageCard } from "@/components";
import { RouteConfig } from "@/utils/routeConfig";
import {
  Affix,
  Button,
  Grid,
  Group,
  Modal,
  NumberInput,
  Pagination,
  Select,
  Stack,
  Switch,
  Text,
  TextInput,
  useMantineTheme,
} from "@mantine/core";
import { IconCheck, IconPlus, IconRestore } from "@tabler/icons-react";
import { deleteRequest, getRequest, patchRequest, postRequest } from "@/service";
import { API_PATH } from "@/utils/apiPath";
import { notifications } from "@mantine/notifications";
import {
  PackageItem,
  PackageApiResponse,
  AddPackagePayload,
} from "@/types/admin/societyManagement/packageSetup/packageSetup";
import { IMAGES } from "@/utils/images";
import {
  BILLING_CYCLE,
  BILLING_DURATION_MAP,
  COMMON_MESSAGE,
  PAGE_TITLE,
  RECORDS_PER_PAGE,
  REGEX_MSG,
  STATUS_OPTIONS,
} from "@/utils/constants";

// ── Constants ─────────────────────────────────────────────────────────────────

const INITIAL_FORM = {
  packageCode: "",
  packageName: "",
  billingCycle: "",
  durationDays: 0,
  price: 0,
  allowsTrial: false,
  trialDays: null as number | null,
  status: "",
};

const INITIAL_ERRORS = {
  packageCode: "",
  packageName: "",
  billingCycle: "",
  durationDays: "",
  price: "",
  trialDays: "",
  status: "",
};

// ── Notification helpers ──────────────────────────────────────────────────────

const notifySuccess = (message: string) =>
  notifications.show({ title: "Successful!", message, color: "green" });

const notifyError = (message: string) =>
  notifications.show({ title: "Error", message, color: "red" });

// ── Component ─────────────────────────────────────────────────────────────────

const PackageSetup = () => {
  const theme = useMantineTheme();
  const [opened, setOpened] = useState(false);
  const [currentPage, setCurrentCPage] = useState(1);
  const [totalPages, setTotalPages] = useState(1);
  const [loading, setLoading] = useState(false);
  const [form, setForm] = useState(INITIAL_FORM);
  const [formErrors, setFormErrors] = useState(INITIAL_ERRORS);
  const [packages, setPackages] = useState<PackageItem[]>([]);
  const [editingPackage, setEditingPackage] = useState<PackageItem | null>(null);
  const [deleteModalOpen, setDeleteModalOpen] = useState(false);
  const [selectedItem, setSelectedItem] = useState<PackageItem | null>(null);

  // ── Helpers ───────────────────────────────────────────────────────────────

  const resetForm = () => {
    setForm(INITIAL_FORM);
    setFormErrors(INITIAL_ERRORS);
  };

  const clearFieldError = (field: keyof typeof INITIAL_ERRORS) =>
    setFormErrors((prev) => ({ ...prev, [field]: "" }));

  const setFormField = (field: keyof typeof INITIAL_FORM, value: unknown) =>
    setForm((prev) => ({ ...prev, [field]: value }));

  // ── Validation ────────────────────────────────────────────────────────────

  const validateForm = () => {
    const errors = { ...INITIAL_ERRORS };

    if (!form.packageCode.trim()) errors.packageCode = REGEX_MSG.PACKAGE_CODE;
    if (!form.packageName.trim()) errors.packageName = REGEX_MSG.PACKAGE_NAME;
    if (!form.billingCycle) errors.billingCycle = REGEX_MSG.BILLING_CYCLE;
    if (form.billingCycle === "CUSTOM" && (!form.durationDays || form.durationDays <= 0 || !Number.isInteger(form.durationDays)))
      errors.durationDays = REGEX_MSG.DURATION_DAYS;
    if (!form.price || form.price <= 0) errors.price = REGEX_MSG.PRICE;
    if (form.allowsTrial && (!form.trialDays || form.trialDays <= 0))
      errors.trialDays = REGEX_MSG.TRIAL_DAYS;

    setFormErrors(errors);
    return !Object.values(errors).some(Boolean);
  };

  // ── Payload builder ───────────────────────────────────────────────────────

  const buildPayload = (): AddPackagePayload => ({
    packageCode: form.packageCode,
    packageName: form.packageName,
    billingCycle: form.billingCycle,
    durationDays: form.billingCycle === "CUSTOM" ? form.durationDays : BILLING_DURATION_MAP[form.billingCycle],
    price: Number(form.price),
    allowsTrial: form.allowsTrial,
    trialDays: form.allowsTrial ? form.trialDays : null,
    status: Number(form.status),
  });

  // ── CRUD handlers ─────────────────────────────────────────────────────────

  const fetchPackage = useCallback(async () => {
    setLoading(true);
    try {
      const response = await getRequest<PackageApiResponse>(API_PATH.GET_PACKAGE, {
        search: "",
        page: String(currentPage),
        limit: String(RECORDS_PER_PAGE),
        sortBy: "created_at",
        sortOrder: "DESC",
      });
      const totalRecords = response?.data?.total;
      setPackages(response?.data?.data);
      if (totalRecords) setTotalPages(Math.ceil(totalRecords / RECORDS_PER_PAGE));
    } catch (err) {
      console.error(err);
      notifyError(COMMON_MESSAGE.PACKAGE_FAIL);
    } finally {
      setLoading(false);
    }
  }, [currentPage]);

  useEffect(() => {
    fetchPackage();
  }, [fetchPackage]);

  const handleDeleteClick = (pkg: PackageItem) => {
    setSelectedItem(pkg);
    setDeleteModalOpen(true);
  };

  const handleConfirmDelete = async () => {
    if (!selectedItem) return;
    try {
      await deleteRequest(`${API_PATH.GET_PACKAGE}/${selectedItem.id}`);
      notifySuccess(COMMON_MESSAGE.PACKAGE_DELETED);
      setDeleteModalOpen(false);
      setSelectedItem(null);
      fetchPackage();
    } catch (error) {
      console.error(error);
      notifyError(COMMON_MESSAGE.PACKAGE_FAIL);
    }
  };

  const handleEditPackage = async (pkg: PackageItem) => {
    try {
      const response = await getRequest<PackageItem>(`${API_PATH.GET_PACKAGE}/${pkg.id}`);
      const data = response?.data;
      setForm({
        packageCode: data.packageCode,
        packageName: data.packageName,
        billingCycle: data.billingCycle,
        durationDays: data.durationDays,
        price: data.price,
        allowsTrial: data.allowsTrial,
        trialDays: data.trialDays,
        status: String(data.status),
      });
      setEditingPackage(pkg);
      setFormErrors(INITIAL_ERRORS);
      setOpened(true);
    } catch (err) {
      console.error(err);
      notifyError(COMMON_MESSAGE.PACKAGE_FAIL);
    }
  };

  const handleSavePackage = async () => {
    if (!validateForm()) return;
    try {
      setLoading(true);
      const payload = buildPayload();
      if (editingPackage) {
        await patchRequest(API_PATH.GET_PACKAGE, { ...payload, id: editingPackage.id });
        notifySuccess(COMMON_MESSAGE.PACKAGE_UPDATED);
      } else {
        await postRequest(API_PATH.GET_PACKAGE, payload);
        notifySuccess(COMMON_MESSAGE.PACKAGE_ADDED);
      }
      setOpened(false);
      setEditingPackage(null);
      fetchPackage();
      resetForm();
    } catch {
      notifyError(editingPackage ? COMMON_MESSAGE.PACKAGE_UPDATE_FAILED : COMMON_MESSAGE.PACKAGE_FAIL);
    } finally {
      setLoading(false);
    }
  };

  const handleCloseModal = () => {
    setOpened(false);
    resetForm();
  };

  // ── Render ────────────────────────────────────────────────────────────────

  const isCustomCycle = form.billingCycle === "CUSTOM";

  return (
    <>
      <AppBreadcrumbs
        items={[
          { label: PAGE_TITLE.SOCIETY_MANAGEMENT, path: RouteConfig.SOCIETY_MGT },
          { label: "Package", path: () => window.history.back() },
          { label: PAGE_TITLE.PACKAGE_SET_UP },
        ]}
      />

      <Group justify="flex-end" mt="md" mb="sm">
        <Affix position={{ bottom: 40, right: 20 }}>
          <Button
            leftSection={<IconPlus size={30} />}
            color="primary.5"
            radius="lg"
            onClick={() => { setEditingPackage(null); resetForm(); setOpened(true); }}
          >
            Add Package
          </Button>
        </Affix>
      </Group>

      {/* ── Modal ── */}
      <Modal
        opened={opened}
        onClose={handleCloseModal}
        title={<Text fw={600}>Add Package</Text>}
        size="lg"
        centered
        styles={{
          header: { backgroundColor: theme.colors.primary[5], color: "white", padding: "16px 20px", margin: "-1px -1px 16px -1px" },
          title: { color: "white", fontWeight: 600 },
          close: { color: "white", "&:hover": { backgroundColor: "rgba(255, 255, 255, 0.7)" } },
        }}
      >
        <Stack gap="md">
          <Grid align="end" gutter="md">
            <Grid.Col span={12}>
              <TextInput
                label="Package Code"
                placeholder="BASIC89970"
                required
                minLength={2}
                maxLength={50}
                value={form.packageCode}
                disabled={editingPackage !== null}
                onChange={(e) => { setFormField("packageCode", e.target.value); clearFieldError("packageCode"); }}
                error={formErrors.packageCode}
              />
            </Grid.Col>
            <Grid.Col span={12}>
              <TextInput
                label="Package Name"
                placeholder="Basic Monthly Package"
                required
                minLength={2}
                maxLength={250}
                value={form.packageName}
                onChange={(e) => { setFormField("packageName", e.target.value); clearFieldError("packageName"); }}
                error={formErrors.packageName}
              />
            </Grid.Col>
          </Grid>

          <Grid gutter="md">
            <Grid.Col span={{ base: 12, md: isCustomCycle ? 4 : 6 }}>
              <Select
                label="Billing Cycle"
                required
                placeholder="Select type of billing cycle"
                data={BILLING_CYCLE}
                value={form.billingCycle}
                clearable
                onChange={(value) => {
                  if (!value) return;
                  setForm((prev) => ({
                    ...prev,
                    billingCycle: value,
                    durationDays: value === "CUSTOM" ? prev.durationDays : BILLING_DURATION_MAP[value],
                  }));
                  clearFieldError("billingCycle");
                }}
                error={formErrors.billingCycle}
              />
            </Grid.Col>

            {isCustomCycle && (
              <Grid.Col span={{ base: 12, md: 4 }}>
                <NumberInput
                  label="Duration (Days)"
                  required
                  min={1}
                  value={form.durationDays}
                  onChange={(value) => { setFormField("durationDays", Number(value)); clearFieldError("durationDays"); }}
                  error={formErrors.durationDays}
                />
              </Grid.Col>
            )}

            <Grid.Col span={{ base: 12, md: isCustomCycle ? 4 : 6 }}>
              <NumberInput
                label="Price (₹)"
                placeholder="999.99"
                required
                min={0}
                decimalScale={2}
                value={form.price}
                onChange={(value) => { setFormField("price", Number(value)); clearFieldError("price"); }}
                error={formErrors.price}
              />
            </Grid.Col>
          </Grid>

          <Grid align="end" gutter="md">
            <Grid.Col span={{ base: 12, md: 3 }} mb="xs">
              <Switch
                label="Allow Trial"
                checked={form.allowsTrial}
                color="primary.5"
                size="md"
                onChange={(e) => {
                  setForm((prev) => ({
                    ...prev,
                    allowsTrial: e.currentTarget.checked,
                    trialDays: e.currentTarget.checked ? prev.trialDays || 1 : null,
                  }));
                  if (e.currentTarget.checked) clearFieldError("trialDays");
                }}
              />
            </Grid.Col>

            <Grid.Col span={{ base: 12, md: 5 }}>
              <NumberInput
                label="Trial Days"
                placeholder="Enter number of days"
                min={1}
                value={form.trialDays || undefined}
                onChange={(value) => { setFormField("trialDays", Number(value)); clearFieldError("trialDays"); }}
                disabled={!form.allowsTrial}
              />
            </Grid.Col>

            <Grid.Col span={{ base: 12, md: 4 }}>
              <Select
                label="Status"
                required
                placeholder="Select status"
                data={STATUS_OPTIONS}
                clearable
                value={form.status}
                onChange={(value) => {
                  if (!value) return;
                  setForm((prev) => ({ ...prev, status: value }));
                  clearFieldError("status");
                }}
                error={formErrors.status}
              />
            </Grid.Col>
          </Grid>

          <Group justify="flex-end" mt="md">
            <Button variant="outline" color="primary.5" leftSection={<IconRestore size={16} />} onClick={handleCloseModal}>
              Cancel
            </Button>
            <Button color="primary.5" leftSection={<IconCheck size={16} />} loading={loading} onClick={handleSavePackage}>
              Save Package
            </Button>
          </Group>
        </Stack>
      </Modal>

      {/* ── Cards Grid ── */}
      <Grid gutter="md">
        {packages.map((pkg, index) => (
          <Grid.Col span={{ base: 12, sm: 6, md: 4 }} key={pkg.id}>
            <PackageCard
              data={pkg}
              index={index}
              onEdit={() => handleEditPackage(pkg)}
              onDelete={() => handleDeleteClick(pkg)}
            />
          </Grid.Col>
        ))}
      </Grid>

      {totalPages > 1 && (
        <Group justify="end" mt="sm">
          <Pagination value={currentPage} onChange={setCurrentCPage} total={totalPages} color="primary.5" />
        </Group>
      )}

      <CustomModal
        opened={deleteModalOpen}
        onClose={() => setDeleteModalOpen(false)}
        icon={IMAGES.WARNING}
        title="Confirm Deletion"
        subtext="Are you sure you want to delete this package?"
        actionText="Yes, Delete"
        onAction={handleConfirmDelete}
        showCancel
        cancelText="No"
      />
    </>
  );
};

export default PackageSetup;