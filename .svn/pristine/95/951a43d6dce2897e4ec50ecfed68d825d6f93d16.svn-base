"use client";

import React from "react";
import {
  Card,
  Stack,
  Group,
  Text,
  Badge,
  ActionIcon,
  useMantineTheme,
} from "@mantine/core";
import {
  IconTag,
  IconCalendar,
  IconClockPlay,
  IconRepeat,
  IconEdit,
  IconTrash,
} from "@tabler/icons-react";

import { PACKAGE_COLORS } from "@/utils/constants";
import { PackageItem } from "@/types/admin/societyManagement/packageSetup/packageSetup";

interface PackageCardProps {
  data: PackageItem;
  index: number;
  onEdit: (data: PackageItem) => void;
  onDelete: (data: PackageItem) => void;
}

// ✅ Dynamic detail rows config — add/remove/reorder here
const getDetailRows = (data: PackageItem) => [
  {
    icon: <IconCalendar size={14} className="text-gray-500" />,
    label: "Duration",
    value: `${data.durationDays} days`,
    type: "text" as const,
  },
  {
    icon: <IconClockPlay size={14} className="text-gray-500" />,
    label: "Trial Period",
    value: data.allowsTrial ? `${data.trialDays} days` : "Not Available",
    type: "badge" as const,
    badgeColor: data.allowsTrial ? "blue" : "gray",
  },
  {
    icon: <IconRepeat size={14} className="text-gray-500" />,
    label: "Billing Cycle",
    value: data.billingCycle,
    type: "badge" as const,
    badgeColor: "violet",
  },
];

const PackageCard: React.FC<PackageCardProps> = ({
  data,
  index,
  onEdit,
  onDelete,
}) => {
  const theme = useMantineTheme();
  const colorKeys = Object.keys(PACKAGE_COLORS) as Array<keyof typeof PACKAGE_COLORS>;
  const colorKey = colorKeys[index % colorKeys.length];
  const cardColour = PACKAGE_COLORS[colorKey];
  const detailRows = getDetailRows(data);

  return (
    <Card
      withBorder
      shadow="lg"
      radius="lg"
      padding="xl"
      bd={`1px solid ${theme.colors.primary[1]}`}
      className="hover:shadow-xl transition-shadow duration-300"
      style={{ height: "100%", display: "flex", flexDirection: "column" }}
    >
      <Stack gap="md" style={{ flex: 1 }}>

        {/* ── Header ── */}
        <Card.Section
          inheritPadding
          py="sm"
          style={{
            background: cardColour.bg,
            margin: "-0.75rem -0.75rem 0.75rem -0.75rem",
          }}
        >
          <Group justify="space-between" align="center">
            <Text fw={500} size="md" c="white">
              {data.packageName}
            </Text>
          </Group>
        </Card.Section>

        {/* ── Package Code + Actions ── */}
        <Group justify="space-between" align="center">
          <Group gap="xs" align="center">
            <IconTag size={12} className="text-gray-400" />
            <Text size="xs" fw={500} c="dimmed">
              {data.packageCode}
            </Text>
          </Group>

          <Group gap={6}>
            <ActionIcon size="md" radius="md" color="blue" variant="light" onClick={() => onEdit(data)}>
              <IconEdit size={18} />
            </ActionIcon>
            <ActionIcon size="md" radius="md" color="red" variant="light" onClick={() => onDelete(data)}>
              <IconTrash size={18} />
            </ActionIcon>
          </Group>
        </Group>

        {/* ── Price + Status ── */}
        <Group justify="space-between" align="center">
          <Text size="2xl" fw={900} className="tracking-tight">
            ₹{data.price}
            <Text span size="sm" fw={500} c="dimmed" className="ml-1">
              / {data.billingCycle.toLowerCase()}
            </Text>
          </Text>

          <Badge
            radius="sm"
            variant="filled"
            color={data?.status === 1 ? "success.5" : "primary.5"}
          >
            {data?.status === 1 ? "ACTIVE" : "INACTIVE"}
          </Badge>

        </Group>

        {/* ── Dynamic Detail Rows ── */}
        <Stack gap="xs" mt="auto">
          {detailRows.map((row, i) => (
            <Group key={i} justify="space-between">
              <Group gap="xs">
                {row.icon}
                <Text size="sm" fw={500}>
                  {row.label}:
                </Text>
              </Group>

              {row.type === "text" ? (
                <Text size="sm" fw={600}>
                  {row.value}
                </Text>
              ) : (
                <Badge size="sm" variant="light" color={row.badgeColor} className="uppercase">
                  {row.value}
                </Badge>
              )}
            </Group>
          ))}
        </Stack>

      </Stack>
    </Card>
  );
};

export default PackageCard;