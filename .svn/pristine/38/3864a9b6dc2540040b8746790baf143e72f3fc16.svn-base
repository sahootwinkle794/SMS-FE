"use client";

import { useCallback, useEffect, useState } from "react";
import { AppBreadcrumbs, AccessRestricted } from "@/components";
import {
    Box,
    Container,
    Flex,
    Text,
    Badge,
    Tooltip,
    Group,
    Stack,
    ActionIcon,
    Modal,
    Button,
    Textarea,
    useMantineTheme,
    Affix,
    Select,
    TextInput,
} from "@mantine/core";
import { DatePickerInput, TimeInput } from "@mantine/dates";
import { IconCheck, IconEyePlus, IconRestore, IconX, } from "@tabler/icons-react";
import { Column, DataTable } from "@/components/DataTable";
import { RECORDS_PER_PAGE, PageTitles, COMMON_MESSAGE, REQUEST_STATUS_UI, REQUEST_STATUS, RequestStatus, PAGE_TITLE, USER_ROLES } from "@/utils/constants";
import { useMenuPermissions } from "@/hooks/useMenuPermissions";
import { usePathname } from "next/navigation";
import moment from "moment";
import { getRequest, postRequest } from "@/service";
import { API_PATH } from "@/utils/apiPath";
import { notifications } from "@mantine/notifications";
import { ScheduleForm, ApiError, GuestUser, GuestUserResponse, DemoRequestFormState, PersonListResponse } from "@/types/admin/leadManagement/demoRequests/demoRequests";
import DemoRequestModalForm from "./ModalForm";
// ── Helpers ───────────────────────────────────────────────────────────────────

const notifyError = (message: string) =>
    notifications.show({ title: "Error", message, color: "red" });

const notifySuccess = (message: string) =>
    notifications.show({ title: "Successful!", message, color: "green" });
/* ================= CONSTANTS ================= */

const SCHEDULE_INITIAL: ScheduleForm = {
    target: null,
    date: null,
    time: "",
    note: "",

    // NEW 👇
    demoBy: "",
    slotId: "",
    meetingLink: "",
};
/* ================= HELPERS ================= */

const isNew = (createdAt: string) =>
    moment().diff(moment(createdAt), "hours") < 24;

const truncate = (text: string, maxLength = 50) =>
    text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;

/* ================= STATUS BADGE ================= */

const StatusBadge = ({ status }: { status: RequestStatus }) => {
    const config =
        REQUEST_STATUS_UI[status] ?? REQUEST_STATUS_UI[REQUEST_STATUS.PENDING];

    return (
        <Badge size="sm" color={config.color} variant="light" radius="sm">
            {config.label}
        </Badge>
    );
};

/* ================= COMPONENT ================= */

const DemoRequests = () => {

    const { canRead } = useMenuPermissions();
    const pathname = usePathname();
    const theme = useMantineTheme();
    const pageTitle = PageTitles[pathname] ?? "this page";

    const [requests, setRequests] = useState<GuestUser[]>([]);
    const [currentPage, setCurrentPage] = useState(1);
    const [opened, setOpened] = useState(false);
    const [totalRecords, setTotalRecords] = useState(0);
    /* ================= SCHEDULE MODAL STATE (optimized) ================= */

    const [scheduleForm, setScheduleForm] = useState<ScheduleForm>(SCHEDULE_INITIAL);
    const [personOptions, setPersonOptions] = useState<
        { label: string; value: string }[]
    >([]);
    const updateSchedule = <K extends keyof ScheduleForm>(
        key: K,
        value: ScheduleForm[K]
    ) => setScheduleForm((prev) => ({ ...prev, [key]: value }));

    /* ================= SORT: New first → descending date ================= */

    const sortedRequests = [...requests].sort((a, b) => {
        const aTime = new Date(a.createdAt).getTime();
        const bTime = new Date(b.createdAt).getTime();

        const aIsNew = Number(isNew(a.createdAt));
        const bIsNew = Number(isNew(b.createdAt));

        return bIsNew !== aIsNew ? bIsNew - aIsNew : bTime - aTime;
    });

    const newCount = sortedRequests.filter((r) => isNew(r.createdAt)).length;

    /* ================= HANDLERS ================= */

    const handleScheduleConfirm = () => {
        if (!scheduleForm.target) return;

        setRequests((prev) =>
            prev.map((r) =>
                r.guest_Id === scheduleForm.target!.guest_Id
                    ? { ...r, status: 2 }
                    : r
            )
        );

        setScheduleForm(SCHEDULE_INITIAL);
    };

    const handleReject = (id: string) => {
        setRequests((prev) =>
            prev.map((r) =>
                r.guest_Id === id ? { ...r, status: 3 } : r
            )
        );
    };

    /* ================= DATA FETCH (EFFECT) ================= */
    const fetchDemoRequestData = useCallback(async () => {
        try {
            const payload = {
                search: "",
                page: currentPage,
                limit: RECORDS_PER_PAGE,
                sortBy: "created_at",
                sortOrder: "DESC",
            };

            const response = await getRequest<GuestUserResponse>(
                API_PATH.GET_GUEST_USER,
                payload,
            );

            setRequests(response?.data?.data)
            setTotalRecords(response?.data?.total ?? 0);
        } catch (err) {
            console.error(err);
            const error = err as ApiError;
            notifyError(error?.response?.data?.message || COMMON_MESSAGE.DEMO_REQUEST_FETCH_FAIL);
        }
    }, [currentPage]);

    const fetchPersonOptions = useCallback(async () => {
        try {
            const response = await postRequest(
                API_PATH.GET_USER_LIST_BY_ROLE,
                { roleCode: USER_ROLES?.ADMIN }
            ) as PersonListResponse;

            const users = response?.data?.data ?? [];
            setPersonOptions(
                users.map((user) => ({
                    label: user.name,
                    value: user.id,
                }))
            );
        } catch (err) {
            console.error(err);
            notifyError(
                (err as ApiError)?.response?.data?.message ||
                COMMON_MESSAGE.SLOT_SETUP_FETCH_FAIL
            );
        }
    }, []);

    /* =================  Fetch users  ================= */
    useEffect(() => {
        const fetchData = async () => {
            await fetchDemoRequestData();
            await fetchPersonOptions();
        };
        fetchData();
    }, [fetchDemoRequestData, fetchPersonOptions]); // ✅ add this

    /* ================= COLUMNS ================= */

    const columns: Column<GuestUser>[] = [
        {
            header: "Sl No",
            accessor: "guest_Id",
            align: "center",
            render: (_value, _row, index) => (
                <Text size="sm" c="dimmed">
                    {(currentPage - 1) * RECORDS_PER_PAGE + index + 1}
                </Text>
            ),
        },
        {
            header: "Action",
            accessor: "guest_Id",
            align: "center",
            render: (_value, row) => {

                const isPending = row.status === REQUEST_STATUS.PENDING;

                if (!isPending) {
                    return (
                        <Text size="xs" c="dimmed">
                            —
                        </Text>
                    );
                }

                return (
                    <Group gap="xs" justify="center" wrap="nowrap">
                        <Tooltip label="Schedule Demo" withArrow>
                            <ActionIcon
                                size="sm"
                                radius="xl"
                                variant="light"
                                color="green"
                                onClick={() => updateSchedule("target", row)}
                            >
                                <IconCheck size={14} />
                            </ActionIcon>
                        </Tooltip>

                        <Tooltip label="Reject Request" withArrow>
                            <ActionIcon
                                size="sm"
                                radius="xl"
                                variant="light"
                                color="red"
                                onClick={() => handleReject(row.guest_Id)}
                            >
                                <IconX size={14} />
                            </ActionIcon>
                        </Tooltip>
                    </Group>
                );
            },
        },
        {
            header: "Name",
            accessor: "full_Name",
            align: "left",
            render: (value, row) => (
                <Group gap="xs">
                    <Text size="sm" fw={500}>
                        {value as string}
                    </Text>
                    {isNew(row.createdAt) && (
                        <Badge size="xs" color="green" variant="filled" radius="xs">
                            New
                        </Badge>
                    )}
                </Group>
            ),
        },
        {
            header: "Mobile",
            accessor: "mobile_No",
            align: "left",
        },
        {
            header: "Email",
            accessor: "email",
            align: "left",
        },
        {
            header: "City",
            accessor: "city",
            align: "left",
            render: (value) => (
                <Badge variant="light" color="violet" radius="sm" size="sm">
                    {value as string}
                </Badge>
            ),
        },
        {
            header: "Description",
            accessor: "projectDescription",
            align: "left",
            render: (value) => {
                const text = value as string;
                return text?.length > 50 ? (
                    <Tooltip label={text} multiline w={280} withArrow>
                        <Text size="sm" c="dimmed" style={{ cursor: "default" }}>
                            {truncate(text)}
                        </Text>
                    </Tooltip>
                ) : (
                    <Text size="sm" c="dimmed">{text}</Text>
                );
            },
        },
        {
            header: "Requested At",
            accessor: "createdAt",
            align: "left",
            render: (value) => (
                <Stack gap={2}>
                    <Text size="sm">
                        {value ? moment(value as string).format("DD MMM YYYY") : "-"}
                    </Text>
                    <Text size="xs" c="dimmed">
                        {value ? moment(value as string).format("hh:mm A") : ""}
                    </Text>
                </Stack>
            ),
        },
        {
            header: "Status",
            accessor: "status",
            align: "center",
            render: (value) => (
                <StatusBadge status={value as RequestStatus} />
            ),
        },

    ];

    if (!canRead) {
        return <AccessRestricted pageTitle={pageTitle} />;
    }

    const handleSubmit = async (data: DemoRequestFormState) => {
        try {
            await postRequest(API_PATH.POST_GUEST_USER_PUBLIC, data);

            notifySuccess(COMMON_MESSAGE.DEMO_REQUEST_CREATE_SUCCESS);

            setOpened(false);
            fetchDemoRequestData();
        } catch (err: unknown) {
            console.error(err);

            const error = err as ApiError;

            notifyError(
                error?.response?.data?.message || COMMON_MESSAGE.DEMO_REQUEST_FETCH_FAIL
            );
        }
    };




    return (
        <Box>
            <Container fluid>
                {/* BREADCRUMB */}
                <Flex justify="space-between" align="center" mb="md">
                    <AppBreadcrumbs
                        items={[{ label: PAGE_TITLE.LEAD_MGT }, { label: PAGE_TITLE.DEMO_REQ }]}
                        newCount={newCount}
                    />
                </Flex>
            </Container>

            {/* TABLE */}
            <DataTable<GuestUser>
                data={requests}
                columns={columns}
                pageSize={RECORDS_PER_PAGE}
                currentPage={currentPage}
                onPageChange={setCurrentPage}
                totalRecords={totalRecords}
            />

            {/* ===== SCHEDULE DEMO MODAL ===== */}
            <Modal
                opened={!!scheduleForm.target}
                onClose={() => setScheduleForm(SCHEDULE_INITIAL)}
                title={
                    <Text fw={600} size="md">
                        Schedule Demo — {scheduleForm.target?.full_Name}
                    </Text>
                }
                styles={{
                    header: { backgroundColor: theme.colors.primary[5], color: "white", padding: "16px 20px", margin: "-1px -1px 16px -1px" },
                    title: { color: "white", fontWeight: 600 },
                    close: { color: "white", "&:hover": { backgroundColor: "rgba(255, 255, 255, 0.7)" } },
                }}
                centered
                radius="md"
                size="sm"
            >
                <Stack gap="md">

                    {/* Demo By */}
                    <Select
                        label="Demo By"
                        placeholder="Select Demo Person"
                        data={personOptions}
                        value={scheduleForm.demoBy}
                        onChange={(val) => updateSchedule("demoBy", val || "")}
                        searchable
                        nothingFoundMessage="No users found"
                        required
                    />
                    {/* Date */}
                    <DatePickerInput
                        label="Demo Date"
                        placeholder="Pick a date"
                        value={scheduleForm.date}
                        onChange={(val) => updateSchedule("date", val as Date | null)}
                        minDate={new Date()}
                        required
                    />

                    {/* Slot instead of time */}
                    <Select
                        label="Slot"
                        placeholder="Select Slot"
                        data={[
                            { value: "morning", label: "Morning (10 AM - 12 PM)" },
                            { value: "afternoon", label: "Afternoon (2 PM - 4 PM)" },
                            { value: "evening", label: "Evening (6 PM - 8 PM)" },
                        ]}
                        value={scheduleForm.slotId}
                        onChange={(val) => updateSchedule("slotId", val || "")}
                        required
                    />

                    {/* Meeting Link */}
                    <TextInput
                        label="Meeting Link"
                        placeholder="https://meet.google.com/..."
                        value={scheduleForm.meetingLink}
                        onChange={(e) => updateSchedule("meetingLink", e.target.value)}
                    />

                    {/* Note */}
                    <Textarea
                        label="Note (optional)"
                        placeholder="Any instructions for the client..."
                        value={scheduleForm.note}
                        onChange={(e) => updateSchedule("note", e.target.value)}
                        rows={3}
                    />

                    <Group justify="flex-end" mt="xs">
                        <Button
                            variant="outline"
                            color="primary.5"
                            leftSection={<IconRestore size={16} />}
                            onClick={() => setScheduleForm(SCHEDULE_INITIAL)}
                        >
                            Cancel
                        </Button>

                        <Button
                            color="primary.5"
                            leftSection={<IconCheck size={16} />}
                            onClick={handleScheduleConfirm}

                        >
                            Confirm Schedule
                        </Button>
                    </Group>
                </Stack>
            </Modal>

            <Affix position={{ bottom: 40, right: 20 }}>
                <Button
                    leftSection={<IconEyePlus size={20} />}
                    radius="xl"
                    size="md"
                    color="primary.5"
                    onClick={() => setOpened(true)}
                    style={{
                        position: "fixed",
                        bottom: 32,
                        right: 32,
                        zIndex: 100,
                        boxShadow: "0 4px 20px rgba(0, 0, 0, 0.15)",
                    }}
                >
                    Add Demo Requests
                </Button>
            </Affix>

            <DemoRequestModalForm
                opened={opened}
                editing={null}
                onClose={() => setOpened(false)}
                onSubmit={handleSubmit}
            />
        </Box>
    );
};

export default DemoRequests;