          <Text fz="xs" fw={700} tt="uppercase" style={{ color: CORAL, letterSpacing: "0.08em" }}>
            {greeting} 👋
          </Text>
          <UnstyledButton onClick={() => setDrawerOpen(true)}>
            <Group gap={6} align="center">
              <Text
                fz={{ base: 16, sm: 20 }}
                fw={900}
                c="#1a1a1a"
                lh={1.2}
                style={{ borderBottom: `2px dashed ${CORAL}`, transition: "color 0.15s ease" }}
