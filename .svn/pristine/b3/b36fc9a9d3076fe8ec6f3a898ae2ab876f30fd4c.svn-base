// ─── Dashboard ────────────────────────────────────────────────────────────────

const SocietyAdminDashboard = () => {
  const greeting = useGreeting();
  const [drawerOpen, setDrawerOpen] = useState(false);

  return (
    <Box style={{ background: PEACH }} p="lg">

      {/* ── Greeting Header ───────────────────────────────────────────────── */}
      <Group justify="space-between" align="center" mb="lg">
