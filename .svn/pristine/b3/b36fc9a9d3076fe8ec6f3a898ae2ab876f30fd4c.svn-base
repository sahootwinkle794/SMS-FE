            <StatCards items={STATS} />
            <MenuSection
              items={MENUS}
              title="Quick Actions"
              onSeeAll={() => console.log("See all menus")}
            />
          </Stack>
        </Grid.Col>

        <Grid.Col span={{ base: 12, md: 4 }}>
          <UpcomingEvents
            items={EVENTS}
            title="Upcoming Events"
            onSeeAll={() => console.log("See all events")}
