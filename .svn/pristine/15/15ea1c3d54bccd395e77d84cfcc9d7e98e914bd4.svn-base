"use client";

import {
  Container,
  Grid,
  Stack,
  Title,
  Text,
  Paper,
  TextInput,
  Textarea,
  Button,
  Image,
  Box,
  Modal,
  Center,
} from "@mantine/core";
import { useForm } from "@mantine/form";
import { useState } from "react";
import { COLORS } from "../../constants";
import { IMAGE } from "../../assets/utils/images";
import { IconCircleCheck, IconX } from "@tabler/icons-react";
import { API_PATH } from "@/utils/apiPath";
import { postRequest } from "@/service";
import { REGEX } from "@/utils/constants";

type FormValues = {
  name: string;
  mobile: string;
  email: string;
  city: string;
  projectDescription: string;
};

export interface ApiError {
  message: string;
  response?: {
    data?: {
      status?: number;
      message?: string;
      data?: unknown[];
    };
  };
}

export default function ContactSection() {
  const [loading, setLoading] = useState(false);
  const [opened, setOpened] = useState(false);
  const [success, setSuccess] = useState(false);
  const [popupMessage, setPopupMessage] = useState("");

  const form = useForm<FormValues>({
    initialValues: {
      name: "",
      mobile: "",
      email: "",
      city: "",
      projectDescription: "",
    },

    validate: {
      name: (value) => (REGEX.NAME.test(value) ? null : "Enter a valid name"),

      mobile: (value) =>
        REGEX.PHONE.test(value) ? null : "Enter valid mobile number",

      email: (value) =>
        REGEX.EMAIL.test(value) ? null : "Invalid email address",

      city: (value) => (value.length === 0 ? "City is required" : null),
    },
  });

  const handleSubmit = async (values: FormValues) => {
    try {
      setLoading(true);

      const payload = {
        fullName: values.name,
        mobileNo: values.mobile,
        email: values.email,
        city: values.city,
        projectDescription: values.projectDescription,
      };

      await postRequest(API_PATH.POST_GUEST_USER_PUBLIC, payload);

      setSuccess(true);
      setPopupMessage(
        "Thank you! Your request has been submitted successfully."
      );
      setOpened(true);

      form.reset();
    } catch (err: unknown) {
      const error = err as ApiError;

      setSuccess(false);
      setPopupMessage(error?.message || "Unable to submit form.");
      setOpened(true);
    } finally {
      setLoading(false);
    }
  };

  return (
    <Box
      className="contacts"
      id="contact"
      style={{ backgroundColor: "white", padding: "60px 0" }}
    >
      {/* POPUP MODAL */}
      <Modal
        opened={opened}
        onClose={() => setOpened(false)}
        centered
        withCloseButton={false}
        radius="lg"
      >
        <Center>
          <Stack align="center" gap="md">
            {success ? (
              <IconCircleCheck size={60} color="green" />
            ) : (
              <IconX size={60} color="red" />
            )}

            <Title order={4}>
              {success ? "Thank You!" : "Submission Failed"}
            </Title>

            <Text ta="center">{popupMessage}</Text>

            <Button
              variant="gradient"
              gradient={{ from: "#FF7853", to: "#FF2C36", deg: 135 }}
              onClick={() => setOpened(false)}
            >
              Close
            </Button>
          </Stack>
        </Center>
      </Modal>

      <Container size="xl">
        <Grid gutter={60} align="center">
          {/* LEFT SIDE CONTENT */}
          <Grid.Col span={{ base: 12, md: 6 }}>
            <Stack gap="xl">
              <Title className="contact-title">
                Ready to discuss <br /> your toughest <br />
                <Text className="contact-title2">tech challenges?</Text>
              </Title>

              <Title className="contact-title3">
                Fill out the form and get on a call within 24-48 hours with our
                product and tech expert.
              </Title>

              <Title className="contact-title3">
                No account managers –
                <Text component="span" className="highlight">
                  {" "}
                  that’s a promise.
                </Text>
              </Title>
            </Stack>
          </Grid.Col>

          {/* RIGHT SIDE FORM */}
          <Grid.Col span={{ base: 12, md: 6 }}>
            <Paper
              shadow="md"
              radius="lg"
              p="xl"
              style={{ border: `1px solid ${COLORS.pinkAccent}` }}
            >
              <form onSubmit={form.onSubmit(handleSubmit)}>
                <Grid gutter="md">
                  <Grid.Col span={{ base: 12, sm: 6 }}>
                    <TextInput
                      label="Hello, my name is:"
                      placeholder="Full name"
                      {...form.getInputProps("name")}
                    />
                  </Grid.Col>

                  <Grid.Col span={{ base: 12, sm: 6 }}>
                    <TextInput
                      label="Mobile No:"
                      maxLength={10}
                      placeholder="9876543210"
                      {...form.getInputProps("mobile")}
                    />
                  </Grid.Col>

                  <Grid.Col span={{ base: 12, sm: 6 }}>
                    <TextInput
                      label="Email ID:"
                      placeholder="your.email@example.com"
                      {...form.getInputProps("email")}
                    />
                  </Grid.Col>

                  <Grid.Col span={{ base: 12, sm: 6 }}>
                    <TextInput
                      label="City:"
                      placeholder="Enter your city"
                      {...form.getInputProps("city")}
                    />
                  </Grid.Col>

                  <Grid.Col span={12}>
                    <Textarea
                      label="I am interested in..."
                      placeholder="Your Project Description"
                      minRows={4}
                      {...form.getInputProps("projectDescription")}
                    />
                  </Grid.Col>

                  <Grid.Col span={12}>
                    <Button
                      className="btn-text"
                      type="submit"
                      loading={loading}
                      size="lg"
                      radius="sm"
                      variant="gradient"
                      gradient={{ from: "#FF7853", to: "#FF2C36", deg: 135 }}
                      rightSection={
                        <Image
                          src={IMAGE.ARROW_IMG}
                          width={18}
                          height={18}
                          alt="icon"
                        />
                      }
                    >
                      Book a demo with us
                    </Button>
                  </Grid.Col>
                </Grid>
              </form>
            </Paper>
          </Grid.Col>
        </Grid>
      </Container>
    </Box>
  );
}