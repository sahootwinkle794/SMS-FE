"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Drawer,
  TextInput,
  Select,
  MultiSelect,
  Textarea,
  NumberInput,
  Flex,
  Box,
  useMantineTheme,
  Button,
  FileInput,
  Fieldset,
  Text,
  Grid,
  ActionIcon,
  Tooltip,
  Stack,
  Loader,
} from "@mantine/core";
import { useForm, isEmail, isNotEmpty } from "@mantine/form";
import { IconCheck, IconRestore, IconPlus, IconTrash } from "@tabler/icons-react";

/* eslint-disable @typescript-eslint/no-explicit-any */

/* -------------------- LOOKUP TYPES -------------------- */
export interface LookupResult {
  success: boolean;
  data?: Record<string, any>;
  error?: string;
}

export interface LookupConfig {
  onLookup: (value: string, entryIndex: number) => Promise<LookupResult>;
  renderResult?: (data: Record<string, any>) => React.ReactNode;
  renderError?: (error: string) => React.ReactNode;
  /** Optional: auto-fill sibling fields in the same entry from result data */
  fillFields?: string[];
  /** Debounce delay in ms before triggering lookup on input change. Defaults to 600 */
  debounceMs?: number;
}

export interface Field {
  name: string;
  label: string;
  isDisabled?: boolean;
  dedupSelect?: boolean;
  type?:
  | "text"
  | "email"
  | "number"
  | "select"
  | "multiselect"
  | "textarea"
  | "date"
  | "file"
  | "password";
  placeholder?: string;
  required?: boolean;
  regex?: RegExp;
  regexMessage?: string;
  options?: { value: string; label: string }[];
  fileType?: "svg" | "png" | "jpg" | "jpeg" | "image";
  fieldset?: string;
  colSpan?: number;
  maxLength?: number;
  minLength?: number;
  liveRegex?: boolean;
  onChange?: (value: any, form: any) => void;
  liveValidation?: boolean;
  /** Optional lookup config — renders a search button beside the field */
  lookupConfig?: LookupConfig;
}

export interface FieldsetConfig {
  id: string;
  legend: string;
  description?: string;
  collapsed?: boolean;
  isMultipleEntry?: boolean;
  multipleEntryKey?: string;
}

interface DrawerFormProps {
  opened: boolean;
  onClose: () => void;
  title: string;
  fields: Field[];
  onSubmit: (formData: Record<string, any>) => void;
  initialValues?: Record<string, any>;
  size?: string;
  position?: "left" | "right" | "top" | "bottom";
  fieldsets?: FieldsetConfig[];
  onRemoveEntry?: (fieldsetId: string, index: number, entryValues: Record<string, any>) => void;
}

export default function DrawerForm({
  opened,
  onClose,
  title,
  fields,
  onSubmit,
  initialValues,
  size,
  position = "right",
  fieldsets = [],
  onRemoveEntry,
}: DrawerFormProps) {
  const theme = useMantineTheme();

  /* -------------------- LOOKUP STATE -------------------- */
  // Key format: `${entryKey}.${index}.${fieldName}` for multi-entry
  //             `${fieldName}` for regular fields
  const [lookupResults, setLookupResults] = useState<Record<string, LookupResult | null>>({});
  const [lookupLoading, setLookupLoading] = useState<Record<string, boolean>>({});
  // Debounce timers keyed by lookupKey
  const debounceTimers = useRef<Record<string, ReturnType<typeof setTimeout>>>({});

  const FILE_TYPE_MAP: Record<string, string> = {
    svg: "image/svg+xml",
    png: "image/png",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    image: "image/*",
  };

  /* -------------------- DEFAULT VALUES -------------------- */
  const defaultValues = fields.reduce((acc, field) => {
    const fieldset = fieldsets.find((fs) => fs.id === field.fieldset);
    if (fieldset?.isMultipleEntry && fieldset.multipleEntryKey) {
      if (!acc[fieldset.multipleEntryKey]) {
        acc[fieldset.multipleEntryKey] = [{}];
      }
      const defaultVal = field.type === "multiselect" ? [] : "";
      acc[fieldset.multipleEntryKey][0][field.name] = defaultVal;
    } else {
      acc[field.name] = field.type === "multiselect" ? [] : "";
    }
    return acc;
  }, {} as Record<string, any>);

  /* -------------------- VALIDATORS -------------------- */
  const validators = fields.reduce((acc, field) => {
    const fieldset = fieldsets.find((fs) => fs.id === field.fieldset);
    if (fieldset?.isMultipleEntry) {
      return acc;
    }
    const rules: any[] = [];

    if (field.required) {
      if (field.type === "email") {
        rules.push(isEmail("Invalid email"));
      } else if (field.type === "multiselect") {
        rules.push((value: any[]) =>
          value && value.length > 0 ? null : `${field.label} is required`
        );
      } else {
        rules.push(isNotEmpty(`${field.label} is required`));
      }
    }

    if (field.regex && field.type !== "multiselect") {
      rules.push((value: string) =>
        field.regex!.test(value)
          ? null
          : field.regexMessage || "Invalid value"
      );
    }

    acc[field.name] = (value: any) => {
      for (const rule of rules) {
        const result = rule(value);
        if (result) return result;
      }
      return null;
    };

    return acc;
  }, {} as Record<string, any>);

  /* -------------------- LIVE VALIDATION HELPER -------------------- */
  const validateFieldLive = (field: Field, value: string) => {
    if (!field.liveValidation) return;

    if (!value || value.length === 0) {
      form.clearFieldError(field.name);
      return;
    }

    if (field.regex && !field.regex.test(value)) {
      form.setFieldError(field.name, field.regexMessage || `Invalid ${field.label}`);
    } else {
      form.clearFieldError(field.name);
    }
  };

  const form = useForm({
    initialValues: defaultValues,
    validate: (values) => {
      const errors: Record<string, string> = {};

      for (const [fieldName, validator] of Object.entries(validators)) {
        const result = validator(values[fieldName]);
        if (result) errors[fieldName] = result;
      }

      for (const config of fieldsets) {
        if (!config.isMultipleEntry || !config.multipleEntryKey) continue;

        const entryKey = config.multipleEntryKey;
        const entries: any[] = values[entryKey] || [];
        const fieldsInFieldset = fields.filter((f) => f.fieldset === config.id);

        entries.forEach((entry, index) => {
          for (const field of fieldsInFieldset) {
            if (!field.required) continue;

            const value = entry[field.name];
            const isEmpty =
              field.type === "multiselect"
                ? !value || value.length === 0
                : !value || value === "";

            if (isEmpty) {
              errors[`${entryKey}.${index}.${field.name}`] =
                `${field.label} is required`;
            }

            if (field.regex && value && !field.regex.test(value)) {
              errors[`${entryKey}.${index}.${field.name}`] =
                field.regexMessage || "Invalid value";
            }
          }
        });
      }

      return errors;
    },
  });

  /* -------------------- EFFECT -------------------- */
  useEffect(() => {
    if (!opened) return;

    if (initialValues && Object.keys(initialValues).length > 0) {
      form.setValues(initialValues);
    } else {
      form.setValues(defaultValues);
    }

    form.clearErrors();
    // Clear lookup state when drawer opens/closes
    setLookupResults({});
    setLookupLoading({});
  }, [opened, initialValues]);

  /* -------------------- GET DEFAULT ENTRY -------------------- */
  const getDefaultEntry = (fieldsetId: string): Record<string, any> => {
    const fieldset = fieldsets.find((fs) => fs.id === fieldsetId);
    if (!fieldset) return {};

    const fieldsInFieldset = fields.filter((f) => f.fieldset === fieldsetId);
    return fieldsInFieldset.reduce((acc, field) => {
      acc[field.name] = field.type === "multiselect" ? [] : "";
      return acc;
    }, {} as Record<string, any>);
  };

  /* -------------------- LOOKUP HANDLER -------------------- */
  /**
   * Handles lookup for both regular fields and multi-entry fields.
   * - Regular field: lookupKey = fieldName
   * - Multi-entry field: lookupKey = `${entryKey}.${index}.${fieldName}`
   */
  const handleLookup = async (
    field: Field,
    value: string,
    lookupKey: string,
    entryIndex: number,
    entryKey?: string,
  ) => {
    if (!field.lookupConfig) return;

    setLookupLoading((prev) => ({ ...prev, [lookupKey]: true }));
    setLookupResults((prev) => ({ ...prev, [lookupKey]: null }));

    try {
      const result = await field.lookupConfig.onLookup(value, entryIndex);
      setLookupResults((prev) => ({ ...prev, [lookupKey]: result }));

      // Auto-fill sibling fields if fillFields is specified and lookup succeeded
      if (result.success && result.data && field.lookupConfig.fillFields) {
        for (const fillFieldName of field.lookupConfig.fillFields) {
          const fillValue = result.data[fillFieldName];
          if (fillValue !== undefined) {
            if (entryKey) {
              form.setFieldValue(`${entryKey}.${entryIndex}.${fillFieldName}`, fillValue);
            } else {
              form.setFieldValue(fillFieldName, fillValue);
            }
          }
        }
      }
    } catch {
      setLookupResults((prev) => ({
        ...prev,
        [lookupKey]: { success: false, error: "An unexpected error occurred." },
      }));
    } finally {
      setLookupLoading((prev) => ({ ...prev, [lookupKey]: false }));
    }
  };

  /* -------------------- DEBOUNCED LOOKUP TRIGGER -------------------- */
  const triggerLookupDebounced = useCallback((
    field: Field,
    value: string,
    lookupKey: string,
    entryIndex: number,
    entryKey?: string,
  ) => {
    // Clear result immediately when user types
    setLookupResults((prev) => ({ ...prev, [lookupKey]: null }));

    // Clear any existing timer for this key
    if (debounceTimers.current[lookupKey]) {
      clearTimeout(debounceTimers.current[lookupKey]);
    }

    if (!value) {
      setLookupLoading((prev) => ({ ...prev, [lookupKey]: false }));
      return;
    }

    const delay = field.lookupConfig?.debounceMs ?? 600;
    debounceTimers.current[lookupKey] = setTimeout(() => {
      handleLookup(field, value, lookupKey, entryIndex, entryKey);
    }, delay);
  }, []);

  /* -------------------- LOOKUP RESULT RENDERER -------------------- */
  const renderLookupResult = (field: Field, lookupKey: string) => {
    const result = lookupResults[lookupKey];
    const isLoading = lookupLoading[lookupKey];

    if (isLoading) {
      return (
        <Flex align="center" gap={6}>
          <Loader size="xs" color="primary.5" />
          <Text size="xs" c="dimmed">Searching...</Text>
        </Flex>
      );
    }

    if (!result) return null;

    if (result.success && result.data) {
      if (field.lookupConfig?.renderResult) {
        return (
          <Box>
            {field.lookupConfig.renderResult(result.data)}
          </Box>
        );
      }
      // Default success display
      return (
        <Box
          p={8}
          style={{
            borderRadius: 6,
            background: theme.colors.green[0],
            border: `1px solid ${theme.colors.green[3]}`,
          }}
        >
          {Object.entries(result.data).map(([key, val]) => (
            <Text key={key} size="xs" c="green.8">
              <strong>{key}:</strong> {String(val)}
            </Text>
          ))}
        </Box>
      );
    }

    if (!result.success && result.error) {
      if (field.lookupConfig?.renderError) {
        return (
          <Box>
            {field.lookupConfig.renderError(result.error)}
          </Box>
        );
      }
      // Default error display
      return (
        <Box
          p={8}
          style={{
            borderRadius: 6,
            background: theme.colors.red[0],
            border: `1px solid ${theme.colors.red[3]}`,
          }}
        >
          <Text size="xs" c="red.7">{result.error}</Text>
        </Box>
      );
    }

    return null;
  };

  /* -------------------- RENDER FIELD FOR MULTIPLE ENTRY -------------------- */
  const renderMultipleEntryField = (
    field: Field,
    entryKey: string,
    index: number
  ) => {
    const fieldPath = `${entryKey}.${index}.${field.name}`;

    // If this field has a lookupConfig, trigger debounced lookup on input change
    if (field.lookupConfig) {
      const lookupKey = fieldPath;
      const currentValue = form.values[entryKey]?.[index]?.[field.name] ?? "";
      const isLoading = lookupLoading[lookupKey];

      return (
        <Box>
          <Flex gap={6} align="flex-end">
            <Box style={{ flex: 1 }}>
              <TextInput
                label={index === 0 ? field.label : undefined}
                placeholder={field.placeholder}
                value={currentValue}
                rightSection={isLoading ? <Loader size={14} color="primary.5" /> : undefined}
                onChange={(e) => {
                  const val = e.currentTarget.value;
                  form.setFieldValue(fieldPath, val);
                  triggerLookupDebounced(field, val, lookupKey, index, entryKey);
                }}
                maxLength={field.maxLength}
                minLength={field.minLength}
                error={form.errors[fieldPath]}
                withAsterisk={field.required && index === 0}
                disabled={field.isDisabled}
              />
            </Box>
            {/* Result shown inline beside the field */}
            <Box style={{ flex: 2, minWidth: 0 }}>
              {renderLookupResult(field, lookupKey)}
            </Box>
          </Flex>
        </Box>
      );
    }

    switch (field.type) {
      case "select": {
        const entryIsExisting = form.values[entryKey]?.[index]?.isExisting ?? false;
        const filteredOptions = (() => {
          if (!field.dedupSelect) return field.options || [];
          const allEntries: any[] = form.values[entryKey] || [];
          const otherSelectedValues = allEntries
            .filter((_, i) => i !== index)
            .map((entry) => entry[field.name])
            .filter(Boolean);
          return (field.options || []).filter(
            (opt) => !otherSelectedValues.includes(opt.value),
          );
        })();

        return (
          <Select
            label={index === 0 ? field.label : undefined}
            placeholder={field.placeholder}
            data={filteredOptions}
            value={form.values[entryKey]?.[index]?.[field.name] || ""}
            onChange={(v) => form.setFieldValue(fieldPath, v ?? "")}
            error={form.errors[fieldPath]}
            searchable
            clearable
            withAsterisk={field.required && index === 0}
            disabled={field.isDisabled && entryIsExisting}
          />
        );
      }

      case "number":
        return (
          <NumberInput
            label={index === 0 ? field.label : undefined}
            placeholder={field.placeholder}
            min={0}
            value={form.values[entryKey]?.[index]?.[field.name] || ""}
            onChange={(v) => form.setFieldValue(fieldPath, v)}
            error={form.errors[fieldPath]}
            withAsterisk={field.required && index === 0}
            maxLength={field.maxLength}
            minLength={field.minLength}
          />
        );

      case "textarea":
        return (
          <Textarea
            label={index === 0 ? field.label : undefined}
            placeholder={field.placeholder}
            autosize
            minRows={2}
            value={form.values[entryKey]?.[index]?.[field.name] || ""}
            onChange={(e) => form.setFieldValue(fieldPath, e.currentTarget.value)}
            error={form.errors[fieldPath]}
            withAsterisk={field.required && index === 0}
          />
        );

      default:
        return (
          <TextInput
            label={index === 0 ? field.label : undefined}
            placeholder={field.placeholder}
            value={form.values[entryKey]?.[index]?.[field.name] ?? ""}
            onChange={(e) => form.setFieldValue(fieldPath, e.currentTarget.value)}
            maxLength={field.maxLength}
            minLength={field.minLength}
            error={form.errors[fieldPath]}
            withAsterisk={field.required && index === 0}
          />
        );
    }
  };

  /* -------------------- RENDER MULTIPLE ENTRY SECTION -------------------- */
  const renderMultipleEntrySection = (config: FieldsetConfig, fieldGroup: Field[]) => {
    const entryKey = config.multipleEntryKey || config.id;
    const entries = form.values[entryKey] || [{}];

    return (
      <Stack>
        {entries.map((_: any, index: number) => (
          <Grid key={index} align="end" gutter="md">
            {fieldGroup.map((field) => (
              <Grid.Col key={field.name} span={field.colSpan ?? 4}>
                {renderMultipleEntryField(field, entryKey, index)}
              </Grid.Col>
            ))}

            <Grid.Col span={1}>
              {entries.length > 1 && (
                <Tooltip label="Remove row">
                  <ActionIcon
                    color="red"
                    variant="light"
                    onClick={() => {
                      onRemoveEntry?.(config.id, index, entries[index]);
                      // Clean up lookup state for this entry
                      const keysToRemove = Object.keys(lookupResults).filter((k) =>
                        k.startsWith(`${entryKey}.${index}.`)
                      );
                      if (keysToRemove.length > 0) {
                        setLookupResults((prev) => {
                          const next = { ...prev };
                          keysToRemove.forEach((k) => delete next[k]);
                          return next;
                        });
                      }
                      form.removeListItem(entryKey, index);
                    }}
                  >
                    <IconTrash size={16} />
                  </ActionIcon>
                </Tooltip>
              )}
            </Grid.Col>
          </Grid>
        ))}

        <Button
          leftSection={<IconPlus size={20} />}
          variant="light"
          color="primary.5"
          onClick={() => form.insertListItem(entryKey, getDefaultEntry(config.id))}
          mt="sm"
        >
          Add More
        </Button>
      </Stack>
    );
  };

  /* -------------------- FIELD RENDERER (regular fields) -------------------- */
  const renderField = (field: Field) => {
    // Regular field with lookup
    if (field.lookupConfig) {
      const lookupKey = field.name;
      const currentValue = form.values[field.name] ?? "";
      const isLoading = lookupLoading[lookupKey];

      return (
        <Box>
          <Flex gap={6} align="flex-end">
            <Box style={{ flex: 1 }}>
              <TextInput
                label={field.label}
                placeholder={field.placeholder}
                value={currentValue}
                error={form.errors[field.name]}
                withAsterisk={field.required}
                maxLength={field.maxLength}
                minLength={field.minLength}
                disabled={field.isDisabled}
                rightSection={isLoading ? <Loader size={14} color="primary.5" /> : undefined}
                onChange={(event) => {
                  const value = event.currentTarget.value;
                  form.setFieldValue(field.name, value);
                  validateFieldLive(field, value);
                  triggerLookupDebounced(field, value, lookupKey, 0);
                  if (field.onChange) field.onChange(value, form);
                }}
              />
            </Box>
            {/* Result shown inline beside the field */}
            <Box style={{ flex: 2, minWidth: 0 }}>
              {renderLookupResult(field, lookupKey)}
            </Box>
          </Flex>
        </Box>
      );
    }

    switch (field.type) {
      case "select":
        return (
          <Select
            label={field.label}
            placeholder={field.placeholder}
            data={field.options || []}
            value={form.values[field.name] || ""}
            onChange={(v) => {
              form.setFieldValue(field.name, v ?? "");
              if (field.onChange) {
                field.onChange(v, form)
              }
            }}
            error={form.errors[field.name]}
            searchable
            clearable
            withAsterisk={field.required}
            disabled={field.isDisabled}
          />
        );

      case "multiselect":
        return (
          <MultiSelect
            label={field.label}
            placeholder={field.placeholder}
            data={field.options || []}
            value={form.values[field.name] || []}
            onChange={(v) => form.setFieldValue(field.name, v)}
            error={form.errors[field.name]}
            searchable
            clearable
            withAsterisk={field.required}
          />
        );

      case "textarea":
        return (
          <Textarea
            label={field.label}
            placeholder={field.placeholder}
            autosize
            minRows={3}
            withAsterisk={field.required}
            {...form.getInputProps(field.name)}
          />
        );

      case "number":
        return (
          <NumberInput
            label={field.label}
            placeholder={field.placeholder}
            withAsterisk={field.required}
            maxLength={field.maxLength}
            minLength={field.minLength}
            {...form.getInputProps(field.name)}
          />
        );

      case "file": {
        const accept =
          field.fileType && FILE_TYPE_MAP[field.fileType]
            ? FILE_TYPE_MAP[field.fileType]
            : undefined;

        return (
          <FileInput
            label={field.label}
            accept={accept}
            clearable
            error={form.errors[field.name]}
            withAsterisk={field.required}
            onChange={(file) => {
              if (!file) {
                form.setFieldValue(field.name, "");
                return;
              }

              const reader = new FileReader();
              reader.onload = () => {
                const base64 = (reader.result as string).split(",")[1];
                form.setFieldValue(field.name, base64);
              };
              reader.readAsDataURL(file);
            }}
          />
        );
      }

      default:
        return (
          <TextInput
            label={field.label}
            placeholder={field.placeholder}
            value={form.values[field.name] ?? ""}
            error={form.errors[field.name]}
            withAsterisk={field.required}
            maxLength={field.maxLength}
            minLength={field.minLength}
            disabled={field.isDisabled}
            onChange={(event) => {
              const value = event.currentTarget.value;
              form.setFieldValue(field.name, value);
              validateFieldLive(field, value);
              if (field.onChange) {
                field.onChange(value, form);
              }
            }}
          />
        );
    }
  };

  const handleClose = () => {
    form.setValues(defaultValues);
    form.clearErrors();
    Object.values(debounceTimers.current).forEach(clearTimeout);
    debounceTimers.current = {};
    setLookupResults({});
    setLookupLoading({});
    onClose();
  };

  /* -------------------- GROUP FIELDS -------------------- */
  const groupedFields = fields.reduce((acc, field) => {
    const key = field.fieldset || "ungrouped";
    acc[key] = acc[key] || [];
    acc[key].push(field);
    return acc;
  }, {} as Record<string, Field[]>);

  /* -------------------- RENDER -------------------- */
  return (
    <Drawer
      opened={opened}
      onClose={handleClose}
      title={title}
      position={position}
      size={size || "md"}
      styles={{
        content: {
          backgroundColor: "var(--background)",
        },
        header: {
          backgroundColor: theme.colors.primary[6],
          borderBottom: "1px solid rgba(255,255,255,0.15)",
        },
        title: {
          color: theme.white,
          fontWeight: 600,
        },
      }}
    >
      <form
        onSubmit={form.onSubmit((values) => {
          onSubmit(values);
          form.reset();
        })}
        style={{ height: "100%", display: "flex", flexDirection: "column" }}
      >
        <Box style={{ flex: 1, overflowY: "auto", padding: 20 }}>
          {Object.entries(groupedFields).map(([fieldsetId, fieldGroup]) => {
            const config = fieldsets.find((fs) => fs.id === fieldsetId);

            if (fieldsetId === "ungrouped") {
              return (
                <Grid key="ungrouped" gutter="md" mb="lg">
                  {fieldGroup.map((field) => (
                    <Grid.Col key={field.name} span={field.colSpan ?? 12}>
                      {renderField(field)}
                    </Grid.Col>
                  ))}
                </Grid>
              );
            }

            return (
              <Fieldset
                variant="filled"
                key={fieldsetId}
                legend={config?.legend}
                mb="lg"
                styles={{
                  root: {
                    border: `1px solid ${theme.colors.primary[2]}`,
                    borderRadius: 8,
                    padding: 16,
                    boxShadow: "1px 1px 3px rgba(0, 0, 0, 0.2)",
                    backgroundColor: theme.colors.primary[0],
                  },
                  legend: { fontWeight: 600 },
                }}
              >
                {config?.description && (
                  <Text size="xs" c="secondary.9" mb="sm">
                    {config.description}
                  </Text>
                )}

                {config?.isMultipleEntry ? (
                  renderMultipleEntrySection(config, fieldGroup)
                ) : (
                  <Grid gutter="md">
                    {fieldGroup.map((field) => (
                      <Grid.Col key={field.name} span={field.colSpan ?? 12}>
                        {renderField(field)}
                      </Grid.Col>
                    ))}
                  </Grid>
                )}
              </Fieldset>
            );
          })}
        </Box>

        {/* Footer */}
        <Box
          style={{
            borderTop: "1px solid #eee",
            padding: 12,
            background: "var(--background)",
          }}
        >
          <Flex justify="flex-end" gap="sm">
            <Button
              variant="outline"
              onClick={() => {
                const resetValues = { ...defaultValues };

                fields.forEach((field) => {
                  if (field.isDisabled) {
                    const fieldset = fieldsets.find((fs) => fs.id === field.fieldset);
                    if (fieldset?.isMultipleEntry && fieldset.multipleEntryKey) {
                      resetValues[fieldset.multipleEntryKey] = form.values[fieldset.multipleEntryKey];
                    } else {
                      resetValues[field.name] = form.values[field.name];
                    }
                  }
                });

                fieldsets.forEach((config) => {
                  if (config.isMultipleEntry && config.multipleEntryKey) {
                    const entryKey = config.multipleEntryKey;
                    const currentEntries = form.values[entryKey] || [];
                    const fieldsInFieldset = fields.filter((f) => f.fieldset === config.id);
                    const hasDisableableFields = fieldsInFieldset.some((f) => f.isDisabled);

                    if (hasDisableableFields) {
                      resetValues[entryKey] = currentEntries.map((entry: any) => {
                        const defaultEntry = getDefaultEntry(config.id);

                        if (entry.isExisting) {
                          fieldsInFieldset.forEach((field) => {
                            if (field.isDisabled) {
                              defaultEntry[field.name] = entry[field.name];
                            }
                          });
                          defaultEntry.isExisting = true;
                        }

                        return defaultEntry;
                      });
                    }
                  }
                });

                form.setValues(resetValues);
                form.clearErrors();
                // Clear lookup results and pending timers on reset
                Object.values(debounceTimers.current).forEach(clearTimeout);
                debounceTimers.current = {};
                setLookupResults({});
                setLookupLoading({});
              }}
              leftSection={<IconRestore size={16} />}
              color="primary.5"
            >
              Reset
            </Button>
            <Button
              type="submit"
              leftSection={<IconCheck size={16} />}
              color="primary.5"
            >
              Submit
            </Button>
          </Flex>
        </Box>
      </form>
    </Drawer>
  );
}