// ─── API response types ───────────────────────────────────────────────────────

export interface AmenityDetail {
  id: string | null;    // mapping record id — null when not yet mapped (isMapped: false)
  amenityId: string;    // actual amenity id
  amenityName: string;
  status: number;       // 1 = active, 0 = inactive
  isMapped: boolean;    // ✅ true = checkbox ON, false = checkbox OFF
}

export interface CategoryWithAmenities {
  categoryCode: string;
  categoryName: string;
  amenityDetails: AmenityDetail[];
}

export interface CatAmenityMapApiResponse {
  status: number;
  message: string;
  data: {
    societyId: string;
    societyName: string;
    categoryDetails: CategoryWithAmenities[];
  };
}

// ─── Society option for dropdown ─────────────────────────────────────────────

export interface SocietyOption {
  value: string;
  label: string;
}

// ─── Checked state — keyed by amenityId (since id can be null for unmapped) ──

export type AmenityCheckedMap = Record<string, boolean>;