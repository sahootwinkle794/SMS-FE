"use client";
import { levelConfig } from "@/utils/constants";
import {Modal,Text,ActionIcon,Tooltip,useMantineTheme,} from "@mantine/core";
import {IconTrash,IconPencil,IconZoomIn,IconZoomOut,IconRefresh,} from "@tabler/icons-react";
import {useRef, useState, useCallback } from "react";

export interface TreeNode {
  status: number;
  menuSeq: number;
  menuUrl: string | undefined;
  id: string;
  menuCode: number;
  menuName: string;
  menuDesc: string;
  menuLevel: number;
  parentMenu: number;
  children?: TreeNode[];
}

interface Props {
  opened: boolean;
  onClose: () => void;
  title: string;
  tree: TreeNode[];
  onAdd: (node: TreeNode) => void;
  onEdit: (node: TreeNode) => void;
  onDelete: (node: TreeNode) => void;
}

const MIN_ZOOM = 0.3;
const MAX_ZOOM = 2;
const ZOOM_STEP = 0.15;

const getFallbackConfig = (level: number) =>
  levelConfig[level] ?? {
    bg: "#ffffff",
    border: "#dee2e6",
    chip: "#f1f3f5",
    chipText: "#495057",
    dot: "#868e96",
  };

export const MenuTree = ({
  opened,
  onClose,
  title,
  tree,
  onAdd,
  onEdit,
  onDelete,
}: Props) => {
  const [zoom, setZoom] = useState(1);
  const [pan, setPan] = useState({ x: 0, y: 0 });
  const [hoveredId, setHoveredId] = useState<string | null>(null);
  const isPanning = useRef(false);
  const lastPos = useRef({ x: 0, y: 0 });
  const containerRef = useRef<HTMLDivElement>(null);
  const theme = useMantineTheme();

  const handleMouseDown = useCallback((e: React.MouseEvent) => {
    if ((e.target as HTMLElement).closest(".tree-node-card")) return;
    isPanning.current = true;
    lastPos.current = { x: e.clientX, y: e.clientY };
    e.preventDefault();
  }, []);

  const handleMouseMove = useCallback((e: React.MouseEvent) => {
    if (!isPanning.current) return;
    const dx = e.clientX - lastPos.current.x;
    const dy = e.clientY - lastPos.current.y;
    lastPos.current = { x: e.clientX, y: e.clientY };
    setPan((prev) => ({ x: prev.x + dx, y: prev.y + dy }));
  }, []);

  const handleMouseUp = useCallback(() => {
    isPanning.current = false;
  }, []);

  const handleWheel = useCallback((e: React.WheelEvent) => {
    e.preventDefault();
    const delta = e.deltaY > 0 ? -ZOOM_STEP : ZOOM_STEP;
    setZoom((prev) => Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, prev + delta)));
  }, []);

  const zoomIn = () => setZoom((z) => Math.min(MAX_ZOOM, z + ZOOM_STEP));
  const zoomOut = () => setZoom((z) => Math.max(MIN_ZOOM, z - ZOOM_STEP));
  const resetView = () => {
    setZoom(1);
    setPan({ x: 0, y: 0 });
  };

  const renderNode = (node: TreeNode) => {
    const cfg = getFallbackConfig(node.menuLevel);
    const isHovered = hoveredId === node.id;

    return (
      <div
        key={node.id}
        style={{
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          position: "relative",
        }}
      >
        {/* Node card */}
        <div
          className="tree-node-card"
          onMouseEnter={() => setHoveredId(node.id)}
          onMouseLeave={() => setHoveredId(null)}
          style={{
            background: cfg.bg,
            border: `1.5px solid ${isHovered ? cfg.dot : cfg.border}`,
            borderRadius: 10,
            padding: "10px 14px",
            minWidth: 170,
            boxShadow: isHovered
              ? `0 4px 16px ${cfg.dot}28, 0 1px 4px rgba(0,0,0,0.06)`
              : "0 1px 3px rgba(0,0,0,0.06)",
            transition: "all 0.18s ease",
            cursor: "default",
            position: "relative",
          }}
        >
          {/* Left accent bar */}
          <div
            style={{
              position: "absolute",
              left: 0,
              top: 10,
              bottom: 10,
              width: 3,
              borderRadius: 99,
              background: cfg.dot,
            }}
          />

          <div style={{ paddingLeft: 10 }}>
            {/* Level chip */}
            <div
              style={{
                display: "inline-flex",
                alignItems: "center",
                gap: 4,
                background: cfg.chip,
                color: cfg.chipText,
                fontSize: 10,
                fontWeight: 600,
                letterSpacing: "0.6px",
                textTransform: "uppercase",
                padding: "2px 7px",
                borderRadius: 99,
                marginBottom: 5,
              }}
            >
              <div
                style={{
                  width: 5,
                  height: 5,
                  borderRadius: "50%",
                  background: cfg.dot,
                }}
              />
              L{node.menuLevel}
            </div>

            <div
              style={{
                display: "flex",
                alignItems: "center",
                justifyContent: "space-between",
                gap: 12,
              }}
            >
              <Text
                fw={600}
                size="sm"
                style={{
                  color: "#1a1a2e",
                  lineHeight: 1.3,
                  maxWidth: 120,
                  wordBreak: "break-word",
                }}
              >
                {node.menuName}
              </Text>
                <Tooltip label="Edit" withinPortal>
                  <ActionIcon
                    size={22}
                    variant="subtle"
                    color="blue"
                    style={{ borderRadius: 6 }}
                    onClick={(e) => {
                      e.stopPropagation();
                      onEdit(node);
                    }}
                  >
                    <IconPencil size={12} />
                  </ActionIcon>
                </Tooltip>
                <Tooltip label="Delete" withinPortal>
                  <ActionIcon
                    size={22}
                    variant="subtle"
                    color="red"
                    style={{ borderRadius: 6 }}
                    onClick={(e) => {
                      e.stopPropagation();
                      onDelete(node);
                    }}
                  >
                    <IconTrash size={12} />
                  </ActionIcon>
                </Tooltip>
            </div>
          </div>
        </div>

        {/* Children connector + children */}
        {node.children && node.children.length > 0 && (
          <div
            style={{
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
            }}
          >
            {/* Vertical stem down from parent node */}
            <div style={{ width: 1.5, height: 28, background: "#d0d7e8" }} />

            {/* Row wrapper — horizontal line sits here spanning full width */}
            <div style={{ position: "relative", display: "flex", gap: 40 }}>
              {/* Horizontal connector — left edge to right edge of this row */}
              <div
                style={{
                  position: "absolute",
                  top: 0,
                  left: 0,
                  right: 0,
                  height: 1.5,
                  background: "#d0d7e8",
                }}
              />

              {node.children.map((child) => (
                <div
                  key={child.id}
                  style={{
                    display: "flex",
                    flexDirection: "column",
                    alignItems: "center",
                    position: "relative",
                  }}
                >
                  {/* Vertical line from horizontal bar down to child */}
                  <div
                    style={{ width: 1.5, height: 28, background: "#d0d7e8" }}
                  />
                  {renderNode(child)}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    );
  };

  return (
    <Modal
      opened={opened}
      onClose={onClose}
      centered
      size="95%"
      padding={0}
      styles={{
        header: {
          backgroundColor: theme.colors.primary[5],
          color: "white",
          padding: "16px 20px",
          margin: "-1px -1px 16px -1px",
        },
        title: {
          color: "white",
          fontWeight: 600,
          textAlign: "center",
          flex: 1,
          marginRight: "-28px",
        },
        close: {
          color: "white",
          "&:hover": {
            backgroundColor: "rgba(255, 255, 255, 0.7)",
          },
        },
      }}
      title={title}
    >
      {/* Zoom controls */}
      <div
        style={{
          position: "absolute",
          bottom: 20,
          right: 20,
          zIndex: 10,
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          gap: 2,
          background: "#ffffff",
          border: "1px solid #eaedf3",
          borderRadius: 10,
          padding: "6px",
          boxShadow: "0 2px 12px rgba(0,0,0,0.08)",
        }}
      >
        <Tooltip label="Zoom in" position="left" withinPortal>
          <ActionIcon
            variant="subtle"
            size={28}
            onClick={zoomIn}
            disabled={zoom >= MAX_ZOOM}
            style={{ borderRadius: 7, color: "#555" }}
          >
            <IconZoomIn size={15} />
          </ActionIcon>
        </Tooltip>

        <div
          style={{
            width: 28,
            textAlign: "center",
            fontSize: 10,
            fontWeight: 700,
            color: "#888",
            letterSpacing: "0.3px",
            padding: "2px 0",
            borderTop: "1px solid #f0f0f5",
            borderBottom: "1px solid #f0f0f5",
            userSelect: "none",
          }}
        >
          {Math.round(zoom * 100)}%
        </div>

        <Tooltip label="Zoom out" position="left" withinPortal>
          <ActionIcon
            variant="subtle"
            size={28}
            onClick={zoomOut}
            disabled={zoom <= MIN_ZOOM}
            style={{ borderRadius: 7, color: "#555" }}
          >
            <IconZoomOut size={15} />
          </ActionIcon>
        </Tooltip>

        <div
          style={{
            width: "100%",
            height: 1,
            background: "#f0f0f5",
            margin: "2px 0",
          }}
        />

        <Tooltip label="Reset view" position="left" withinPortal>
          <ActionIcon
            variant="subtle"
            size={28}
            onClick={resetView}
            style={{ borderRadius: 7, color: "#888" }}
          >
            <IconRefresh size={14} />
          </ActionIcon>
        </Tooltip>
      </div>

      {/* Canvas */}
      <div
        ref={containerRef}
        onMouseDown={handleMouseDown}
        onMouseMove={handleMouseMove}
        onMouseUp={handleMouseUp}
        onMouseLeave={handleMouseUp}
        onWheel={handleWheel}
        style={{
          width: "100%",
          height: "100%",
          overflow: "hidden",
          cursor: "grab",
          userSelect: "none",
          // Subtle dot grid background
          backgroundImage:
            "radial-gradient(circle, #d8dde8 1px, transparent 1px)",
          backgroundSize: "24px 24px",
          backgroundColor: "#f7f8fc",
        }}
      >
        <div
          style={{
            transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`,
            transformOrigin: "center top",
            transition: "transform 0.05s ease-out",
            display: "flex",
            justifyContent: "center",
            alignItems: "flex-start",
            gap: 80,
            padding: "48px 80px",
            minWidth: "max-content",
            minHeight: 300,
          }}
        >
          {tree.map((root) => renderNode(root))}
        </div>
      </div>
    </Modal>
  );
};
