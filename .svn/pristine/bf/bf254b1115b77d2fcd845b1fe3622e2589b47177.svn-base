"use client";

import { useState } from "react";
import { useAuthStore } from "@/store/auth.store";
import { ResidentManagement } from "@/app/shared/ResidentManagement";
import { ResidentFormValues } from "@/app/shared/ResidentManagement/ResidentManagement.types";
import { notifications } from "@mantine/notifications";
import { ACCESS_TYPE } from "@/utils/constants";

const VisitorDashboard = () => {
  const user = useAuthStore((state) => state.user);
  const [hasSubmitted, setHasSubmitted] = useState(false);

  const handleSubmit = async (values: ResidentFormValues) => {
    try {
      // TODO: replace with real API call
      // await postRequest(API_PATH.RESIDENT_REGISTER, values);
      console.log("Resident form submitted:", values);
      setHasSubmitted(true);
      notifications.show({ title: "Submitted!", message: "Your registration request has been sent.", color: "teal" });
    } catch {
      notifications.show({ title: "Error", message: "Failed to submit. Please try again.", color: "red" });
    }
  };

  return (
    <ResidentManagement
      role={ACCESS_TYPE.RESIDENT as any}
      residentPhone={user?.userId ?? ""}
      hasSubmitted={hasSubmitted}
      onSubmitForm={handleSubmit}
    />
  );
};

export default VisitorDashboard;