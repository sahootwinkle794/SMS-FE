"use client";

import { OtpInput } from "@/components";
import { postRequest } from "@/service";
import apiServer from "@/service/axios-server";
import {
  ApiResponseData,
  OtpResponse,
  UserResponse,
} from "@/types/auth/login/login";
import { API_PATH } from "@/utils/apiPath";
import { STATUS_MESSAGE } from "@/utils/constants";
import { IMAGES } from "@/utils/images";
import { RouteConfig } from "@/utils/routeConfig";
import { useAuthStore } from "@/store/auth.store";
import classes from "./Login.module.css";

import {
  Button,
  Center,
  Flex,
  Paper,
  Text,
  TextInput,
  Box,
  Image,
  MantineTheme,
} from "@mantine/core";
import { Carousel } from "@mantine/carousel";
import "@mantine/carousel/styles.css";
import Autoplay from "embla-carousel-autoplay";
import { useForm } from "@mantine/form";
import { notifications } from "@mantine/notifications";
import { IconDeviceMobile, IconNumber91Small } from "@tabler/icons-react";
import { useRouter } from "next/navigation";
import { useCallback, useRef, useState, useMemo } from "react";
import { useErrorBoundary } from "react-error-boundary";

// ✅ Module-level constants — defined once, never recreated
const SLIDES = [
  IMAGES.SLIDE_IMG_1,
  IMAGES.SLIDE_IMG_2,
  IMAGES.SLIDE_IMG_3,
  IMAGES.SLIDE_IMG_4,
  IMAGES.SLIDE_IMG_5,
];

const MOBILE_VALIDATOR = (value: string) =>
  /^\d{10}$/.test(value) ? null : "Invalid mobile number";

const FORM_INITIAL_VALUES = { mobile: "" };

const MOBILE_LEFT_SECTION = <IconNumber91Small size={24} stroke={2} />;

const MOBILE_RIGHT_SECTION = (
  <Box
    bg="primary.5"
    px={9}
    py={8}
    style={{
      borderRadius: 4,
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
    }}
  >
    <IconDeviceMobile size={18} color="white" />
  </Box>
);

// ✅ Extracted to avoid inline style recreation on each render
const MOBILE_INPUT_STYLES = (theme: MantineTheme) => ({
  input: {
    backgroundColor: "#F1F3F6",
    borderColor: theme.colors.primary[4],
    "&:focus, &:focusWithin": {
      borderColor: theme.colors.primary[6],
    },
  },
});

// ✅ Extracted notification configs
const showSuccess = (message: string) =>
  notifications.show({
    title: STATUS_MESSAGE.SUCCESSFUL,
    message,
    color: "green",
  });

const showError = (title: string, message: string) =>
  notifications.show({ title, message, color: "red" });

const Login = () => {
  const router = useRouter();
  const { showBoundary } = useErrorBoundary();
  const autoplay = useRef(Autoplay({ delay: 3000 }));
  const setUser = useAuthStore((state) => state.setUser);

  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");

  const form = useForm({
    initialValues: FORM_INITIAL_VALUES,
    validate: { mobile: MOBILE_VALIDATOR },
  });

  const handleSubmit = useCallback(
    async (values: { mobile: string }) => {
      try {
        const responseData = await postRequest<
          typeof values,
          ApiResponseData<OtpResponse>
        >(API_PATH.SEND_OTP, values);

        if (responseData?.data?.ok) {
          showSuccess(STATUS_MESSAGE.OTP_SENT);
          setOtpSent(true);
        } else {
          showError(STATUS_MESSAGE.FAILED, STATUS_MESSAGE.OTP_FAILED);
        }
      } catch (err) {
        showBoundary(err);
      }
    },
    [showBoundary],
  );

  const handleVerifyOtp = useCallback(async () => {
    try {
      const payload = { mobile: form.values.mobile, otp };
      const result = await apiServer.post<UserResponse>(
        "/api/auth/verify-otp",
        payload,
      );

      setUser(result.data); // ✅ Using selector instead of getState()

      showSuccess(STATUS_MESSAGE.OTP_VERIFIED);
      router.push(RouteConfig.DASHBOARD);
    } catch (err) {
      showError("Error", `Failed to verify OTP: ${err}`);
    }
  }, [form.values.mobile, otp, router, setUser]);

  // ✅ Memoized slides to avoid re-rendering carousel items unnecessarily
  const carouselSlides = useMemo(
    () =>
      SLIDES.map((img, index) => (
        <Carousel.Slide key={index}>
          <Center h="100%">
            <Image
              src={img}
              alt={`Slide ${index + 1}`}
              fit="contain"
              h="65%"
              w="65%"
            />
          </Center>
        </Carousel.Slide>
      )),
    [],
  );

  return (
    <Flex h="100vh">
      {/* LEFT SECTION – LOGIN FORM */}
      <Center w={420} px="xl">
        <Box w="100%">
          <Center>
            <Image
              src={IMAGES.BRAND_LOGO}
              alt="SMS Login Logo"
              w={120}
              h={120}
              fit="contain"
            />
          </Center>
          <Center>
            <Text c="dark" fw="bold" size="sm">
              Login into your account
            </Text>
          </Center>

          <Paper withBorder shadow="md" p={30} mt={30} radius="md">
            {!otpSent ? (
              <form onSubmit={form.onSubmit(handleSubmit)}>
                <TextInput
                  label="Mobile Number"
                  placeholder="Enter 10-digit Mobile Number"
                  leftSectionPointerEvents="none"
                  leftSection={MOBILE_LEFT_SECTION}
                  rightSection={MOBILE_RIGHT_SECTION}
                  maxLength={10}
                  inputMode="numeric"
                  withAsterisk
                  styles={MOBILE_INPUT_STYLES}
                  {...form.getInputProps("mobile")}
                />
                <Button fullWidth mt="xl" type="submit" color="primary.5">
                  Send OTP
                </Button>
              </form>
            ) : (
              <>
                <Flex justify="center" mt="md">
                  <OtpInput length={6} timerSeconds={10} onComplete={setOtp} />
                </Flex>
                <Button
                  fullWidth
                  mt="xl"
                  color="primary.5"
                  onClick={handleVerifyOtp}
                >
                  Verify
                </Button>
              </>
            )}
          </Paper>
        </Box>
      </Center>

      {/* RIGHT SECTION – CAROUSEL */}
      <Box flex={1} bg="#f8f9fa" visibleFrom="md">
        <Carousel
          withIndicators
          withControls={false}
          height="100%"
          plugins={[autoplay.current]}
          onMouseEnter={autoplay.current.stop}
          onMouseLeave={autoplay.current.reset}
          classNames={classes}
        >
          {carouselSlides}
        </Carousel>
      </Box>
    </Flex>
  );
};

export default Login;
