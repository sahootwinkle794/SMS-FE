"use client";

import { useState, useCallback, useMemo } from "react";
import { excelToJsonData } from "@/utils/common";
import { useForm } from "@mantine/form";
import {
  Breadcrumbs,
  Anchor,
  FileInput,
  Grid,
  Button,
  Table,
  ScrollArea,
  Alert,
  Loader,
  Text,
  Stack,
} from "@mantine/core";
import { IconAlertCircle } from "@tabler/icons-react";

// ── Types ────────────────────────────────────────────────────────────────────
type ExcelRow = Record<string, string | number | boolean | null>;

interface FormValues {
  file: File | null;
}

// ── Sub-component (stable reference, no prop drilling of setState) ───────────
function DataTable({ rows }: { rows: ExcelRow[] }) {
  if (!rows.length) return null;

  const columns = Object.keys(rows[0]);

  return (
    <ScrollArea mt="md">
      <Table striped highlightOnHover withTableBorder withColumnBorders>
        <Table.Thead>
          <Table.Tr>
            {columns.map((col) => (
              <Table.Th key={col}>{col}</Table.Th>
            ))}
          </Table.Tr>
        </Table.Thead>
        <Table.Tbody>
          {rows.map((row, i) => (
            <Table.Tr key={i}>
              {columns.map((col) => (
                <Table.Td key={col}>{String(row[col] ?? "")}</Table.Td>
              ))}
            </Table.Tr>
          ))}
        </Table.Tbody>
      </Table>
    </ScrollArea>
  );
}

// ── Main component ────────────────────────────────────────────────────────────
const SocietySetup = () => {
  const [excelData, setExcelData] = useState<ExcelRow[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Memoised so the array isn't rebuilt on every render
  const breadcrumbItems = useMemo(
    () =>
      [
        { title: "Setup", href: "#" },
        { title: "Society Setup", href: "#" },
      ].map((item, index) => (
        <Anchor href={item.href} key={index}>
          {item.title}
        </Anchor>
      )),
    [],
  );

  const form = useForm<FormValues>({
    mode: "uncontrolled",
    initialValues: { file: null },
    validate: {
      file: (value) => (value ? null : "Please upload an Excel file"),
    },
  });

  // Stable reference — won't cause child re-renders
  const handleSubmit = useCallback(async (values: FormValues) => {
    setLoading(true);
    setError(null);
    try {
      const jsonData: ExcelRow[] = await excelToJsonData(values);
      setExcelData(jsonData);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Failed to parse the Excel file.",
      );
      setExcelData([]);
    } finally {
      setLoading(false);
    }
  }, []);

  const handleClear = useCallback(() => {
    form.reset();
    setExcelData([]);
    setError(null);
  }, [form]);

  return (
    <>
      <Breadcrumbs separator=">" separatorMargin="xs" mt="md" mb="md">
        {breadcrumbItems}
      </Breadcrumbs>

      <div className="bodySection">
        <form onSubmit={form.onSubmit(handleSubmit)}>
          <Grid>
            <Grid.Col span={{ base: 12, md: 6, lg: 4 }}>
              <Stack gap="xs">
                <FileInput
                  label="Upload Excel File"
                  placeholder="Upload .xlsx or .xls"
                  accept=".xlsx,.xls"
                  disabled={loading}
                  key={form.key("file")}
                  {...form.getInputProps("file")}
                />

                {error && (
                  <Alert
                    icon={<IconAlertCircle size={16} />}
                    color="red"
                    variant="light"
                  >
                    {error}
                  </Alert>
                )}

                <div className="buttonSection">
                  <Button
                    mt="md"
                    type="submit"
                    mr="xs"
                    loading={loading}
                    disabled={loading}
                  >
                    {loading ? <Loader size="xs" /> : "Submit"}
                  </Button>
                  <Button
                    mt="md"
                    variant="light"
                    color="red"
                    disabled={loading}
                    onClick={handleClear}
                  >
                    Clear
                  </Button>
                </div>
              </Stack>
            </Grid.Col>
          </Grid>
        </form>

        {excelData.length > 0 && (
          <Text mt="md" size="sm" c="dimmed">
            {excelData.length} row{excelData.length !== 1 ? "s" : ""} loaded
          </Text>
        )}

        <DataTable rows={excelData} />
      </div>
    </>
  );
};

export default SocietySetup;
